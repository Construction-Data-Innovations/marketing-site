---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LandingNav from '../../components/landing/LandingNav.astro';
import LandingFooter from '../../components/landing/LandingFooter.astro';
import '../../styles/blog.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(entry => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const CATEGORY_LABELS: Record<string, string> = {
  'inside-track': 'Inside Track',
  'product-updates': 'Product Updates',
  'industry-insights': 'Industry Insights',
  'co-authored': 'Co-Authored',
};

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }).toUpperCase();
}

const { title, excerpt, category, author, authorTitle, publishDate, readTime, heroImage } = entry.data;
const categoryLabel = CATEGORY_LABELS[category] ?? category;

const tocHeadings = headings.filter(h => h.depth === 2);

function getInitials(name: string) {
  return name.split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase();
}
---
<BaseLayout title={`${title} — ConstructWise Blog`} description={excerpt}>
  <div class="min-h-screen bg-white">
    <LandingNav />

    <main class="pt-20">
      <!-- Post head -->
      <div class="max-w-screen-xl mx-auto px-4 md:px-8 pt-12 pb-0">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-1.5 text-sm text-gray-400 mb-6">
          <a href="/blog" class="hover:text-gray-700 transition-colors">Blog</a>
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" class="text-gray-300">
            <path d="M4.5 2.5L7.5 6l-3 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class={`cw-lane cw-lane--${category}`}>{categoryLabel}</span>
        </nav>

        <!-- Title -->
        <h1
          class="text-3xl md:text-4xl lg:text-[2.75rem] font-extrabold tracking-tight text-slate-950 max-w-[22ch] leading-[1.08] mb-5"
          style="text-wrap: balance;"
        >{title}</h1>

        <!-- Dek -->
        <p class="text-lg md:text-xl text-gray-500 leading-relaxed max-w-[52ch] mb-8">{excerpt}</p>

        <!-- Meta (date + read time only — author appears in the bio card below) -->
        <div class="flex items-center gap-6 pb-2">
          <span class="font-mono text-xs text-gray-400 tracking-widest uppercase">{formatDate(publishDate)}</span>
          <span class="font-mono text-xs text-gray-400 tracking-widest uppercase">{readTime} min read</span>
        </div>
      </div>

      <!-- Hero image -->
      <div class="max-w-screen-xl mx-auto px-4 md:px-8 mt-10">
        <div class="cw-hero flex items-center justify-center">
          {heroImage ? (
            <img src={heroImage} alt="" class="w-full h-full object-cover" />
          ) : (
            <div class="w-full h-full bg-gradient-to-br from-blue-50 via-slate-100 to-blue-100 flex items-center justify-center">
              <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1" class="opacity-40">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
            </div>
          )}
        </div>
      </div>

      <!-- Article body: editorial two-column layout -->
      <div class="max-w-screen-xl mx-auto px-4 md:px-8 py-14">
        <div class="cw-layout-editorial">
          <!-- Article -->
          <article class="cw-article">
            <Content />
          </article>

          <!-- Sidebar -->
          <aside class="cw-rail">
            <div class="cw-rail-inner">
              {tocHeadings.length > 0 && (
                <nav class="cw-toc">
                  <span class="cw-toc-label">In this article</span>
                  <ol>
                    {tocHeadings.map(h => (
                      <li>
                        <a href={`#${h.slug}`}>{h.text}</a>
                      </li>
                    ))}
                  </ol>
                </nav>
              )}

              <div class="cw-session">
                <span class="cw-session-label">Try ConstructWise</span>
                <p>Build your own GC budget before sub quotes land — from your own cost history.</p>
                <a
                  href="/pricing"
                  class="inline-flex items-center justify-center h-10 w-full rounded-lg bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700 transition-colors"
                >
                  Sign Up Now
                </a>
                <a
                  href="/demo?from=blog"
                  class="mt-2 inline-flex items-center justify-center h-10 w-full rounded-lg border border-gray-300 bg-white text-gray-900 text-sm font-semibold hover:bg-gray-50 hover:border-gray-400 transition-colors"
                >
                  Request a Demo
                </a>
              </div>
            </div>
          </aside>
        </div>
      </div>

      <!-- Author bio -->
      <div class="max-w-screen-xl mx-auto px-4 md:px-8 pb-20">
        <div class="border-t border-gray-100 pt-12">
          <div class="max-w-md bg-gray-50 rounded-2xl p-7 flex flex-col gap-4">
            <div class="flex items-center gap-4">
              <div class="w-14 h-14 rounded-full bg-slate-900 text-white flex items-center justify-center font-bold text-base flex-shrink-0">
                {getInitials(author)}
              </div>
              <div>
                <div class="font-bold text-gray-900">{author}</div>
                <div class="text-sm text-gray-500">{authorTitle}</div>
              </div>
            </div>
            <p class="text-sm text-gray-600 leading-relaxed">
              Third-generation California builder. Former head of Preconstruction and project manager.
            </p>
            <a
              href="https://www.linkedin.com/company/constructwise"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 border border-blue-700 text-blue-700 text-xs font-bold tracking-widest uppercase px-4 py-2.5 rounded-lg hover:bg-blue-50 transition-colors w-fit"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="#0a66c2">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              Connect on LinkedIn
            </a>
          </div>
        </div>
      </div>
    </main>

    <LandingFooter />
  </div>
</BaseLayout>

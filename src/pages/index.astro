---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingNav from '../components/landing/LandingNav.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
---
<BaseLayout>
  <div class="min-h-screen bg-gradient-to-b from-slate-50 to-white pt-20">
    <LandingNav />

    <section class="pt-12 md:pt-16 pb-16 px-4">
      <div class="container mx-auto max-w-7xl">

        <!-- Two-column hero: text + interactive graphic (5-col grid gives graphic ~60%) -->
        <div class="grid lg:grid-cols-5 gap-10 lg:gap-14 items-center mb-14 md:mb-16">

          <!-- Left: text content -->
          <div class="text-center lg:text-left lg:col-span-2">
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-7 leading-[1.05]">
              Intelligent Bid Estimation &amp; Schedule Planning{" "}
              <span class="text-blue-600">for the Construction Industry</span>
            </h1>
            <p class="text-lg md:text-xl text-gray-700 mb-9 leading-relaxed font-medium">
              ConstructWise is the shared brain of your construction business &mdash; recording every bid, schedule, and hard-won decision so every estimator, project manager, and executive operates with the collective instinct of the people they work with.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
              <a
                href="/pricing"
                class="inline-flex items-center justify-center rounded-md text-lg px-8 py-3 h-12 bg-blue-600 text-white hover:bg-blue-700 transition-colors duration-300 font-semibold shadow-sm"
              >
                Get started &rarr;
              </a>
              <a
                href="/solutions"
                class="inline-flex items-center justify-center rounded-md text-lg px-8 py-3 h-12 bg-white border border-blue-600 text-blue-600 hover:bg-blue-50 transition-colors duration-300 font-semibold"
              >
                See what's included
              </a>
            </div>
          </div>

          <!-- Right: interactive hero graphic — 3-card layout adapted from Claude Design mockup -->
          <div class="relative hero-graphic-wrap lg:col-span-3">
            <!-- ambient glow behind -->
            <div class="absolute -inset-4 bg-gradient-to-br from-blue-100 via-indigo-50 to-transparent rounded-3xl blur-2xl opacity-70 pointer-events-none"></div>

            <div class="hero-graphic-inner" style="position: relative; width: 100%; max-width: 940px; aspect-ratio: 940 / 530; margin-left: auto;">

              <!-- CONNECTOR FLOW: SVG paths + animated dots between the cards -->
              <svg viewBox="0 0 940 530" preserveAspectRatio="xMidYMid meet" style="position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; z-index: 3;" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <path id="cwFlowA" d="M498,180 C525,155 545,128 564,120" fill="none"></path>
                  <path id="cwFlowB" d="M564,262 C540,290 540,340 564,368" fill="none"></path>
                </defs>
                <use href="#cwFlowA" fill="none" stroke="#cdcff5" stroke-width="1" stroke-dasharray="1.5 4"></use>
                <use href="#cwFlowB" fill="none" stroke="#cdcff5" stroke-width="1" stroke-dasharray="1.5 4"></use>
                <circle r="3.6" fill="#7c7ff0">
                  <animateMotion dur="2.4s" repeatCount="indefinite" begin="0s"><mpath href="#cwFlowA"></mpath></animateMotion>
                  <animate attributeName="opacity" dur="2.4s" repeatCount="indefinite" begin="0s" values="0;1;1;0" keyTimes="0;0.15;0.8;1"></animate>
                </circle>
                <circle r="3.6" fill="#7c7ff0">
                  <animateMotion dur="2.4s" repeatCount="indefinite" begin="0.8s"><mpath href="#cwFlowA"></mpath></animateMotion>
                  <animate attributeName="opacity" dur="2.4s" repeatCount="indefinite" begin="0.8s" values="0;1;1;0" keyTimes="0;0.15;0.8;1"></animate>
                </circle>
                <circle r="3.6" fill="#7c7ff0">
                  <animateMotion dur="2.4s" repeatCount="indefinite" begin="1.6s"><mpath href="#cwFlowA"></mpath></animateMotion>
                  <animate attributeName="opacity" dur="2.4s" repeatCount="indefinite" begin="1.6s" values="0;1;1;0" keyTimes="0;0.15;0.8;1"></animate>
                </circle>
                <circle r="3.6" fill="#8b8ff0">
                  <animateMotion dur="2.6s" repeatCount="indefinite" begin="1.2s"><mpath href="#cwFlowB"></mpath></animateMotion>
                  <animate attributeName="opacity" dur="2.6s" repeatCount="indefinite" begin="1.2s" values="0;1;1;0" keyTimes="0;0.15;0.8;1"></animate>
                </circle>
                <circle r="3.6" fill="#8b8ff0">
                  <animateMotion dur="2.6s" repeatCount="indefinite" begin="2s"><mpath href="#cwFlowB"></mpath></animateMotion>
                  <animate attributeName="opacity" dur="2.6s" repeatCount="indefinite" begin="2s" values="0;1;1;0" keyTimes="0;0.15;0.8;1"></animate>
                </circle>
                <circle r="3.6" fill="#8b8ff0">
                  <animateMotion dur="2.6s" repeatCount="indefinite" begin="2.8s"><mpath href="#cwFlowB"></mpath></animateMotion>
                  <animate attributeName="opacity" dur="2.6s" repeatCount="indefinite" begin="2.8s" values="0;1;1;0" keyTimes="0;0.15;0.8;1"></animate>
                </circle>
              </svg>

              <!-- ================================================================== -->
              <!-- CARD 1 (BIG, LEFT): STRUCTURAL PLAN                                -->
              <!-- 560×530 in mockup ⇒ 59.57% wide, 100% tall of the 940×530 container -->
              <!-- ================================================================== -->
              <div style="position: absolute; left: 0; top: 0; width: 53%; height: 100%; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 22px; box-shadow: 0 14px 48px rgba(15,27,45,0.09); padding: 4.5%; box-sizing: border-box; display: flex; flex-direction: column;">
                <div style="font-size: 1.28cqw; font-weight: 700; letter-spacing: 1.4px; color: #64748b;">STRUCTURAL PLAN</div>
                <div style="flex: 1; display: flex; align-items: center; min-height: 0; margin-top: 6px;">
                  <svg viewBox="0 0 400 300" width="100%" style="display: block;" font-family="Inter, sans-serif" xmlns="http://www.w3.org/2000/svg">
                    <!-- sheet border -->
                    <rect x="4" y="4" width="392" height="292" rx="3" fill="none" stroke="#c3cfdd" stroke-width="1"></rect>

                    <!-- ===== SITE ===== -->
                    <rect x="12" y="14" width="320" height="270" fill="none" stroke="#a8c2ea" stroke-width="1.3" stroke-dasharray="6 4"></rect>
                    <!-- employee parking (rear, top-left) -->
                    <text x="20" y="24" font-size="7" letter-spacing=".5" fill="#7f97c4" font-weight="600">EMPLOYEE PARKING</text>
                    <g stroke="#a8c2ea" stroke-width="1">
                      <line x1="20" y1="48" x2="120" y2="48"></line>
                      <line x1="26" y1="30" x2="26" y2="48"></line><line x1="37" y1="30" x2="37" y2="48"></line><line x1="48" y1="30" x2="48" y2="48"></line><line x1="59" y1="30" x2="59" y2="48"></line><line x1="70" y1="30" x2="70" y2="48"></line><line x1="81" y1="30" x2="81" y2="48"></line><line x1="92" y1="30" x2="92" y2="48"></line><line x1="103" y1="30" x2="103" y2="48"></line><line x1="114" y1="30" x2="114" y2="48"></line>
                      <line x1="26" y1="48" x2="26" y2="66"></line><line x1="37" y1="48" x2="37" y2="66"></line><line x1="48" y1="48" x2="48" y2="66"></line><line x1="59" y1="48" x2="59" y2="66"></line><line x1="70" y1="48" x2="70" y2="66"></line><line x1="81" y1="48" x2="81" y2="66"></line><line x1="92" y1="48" x2="92" y2="66"></line><line x1="103" y1="48" x2="103" y2="66"></line><line x1="114" y1="48" x2="114" y2="66"></line>
                    </g>
                    <!-- detention pond -->
                    <ellipse cx="200" cy="40" rx="42" ry="12" fill="none" stroke="#a8c2ea" stroke-width="1.2" stroke-dasharray="4 3"></ellipse>
                    <text x="200" y="42" font-size="6" fill="#7f97c4" text-anchor="middle" font-weight="600">DETENTION POND</text>
                    <!-- north arrow -->
                    <g transform="translate(318,32)">
                      <circle r="9" fill="none" stroke="#a8c2ea" stroke-width="1.2"></circle>
                      <path d="M0,-6 L3.5,4 L0,1 L-3.5,4 Z" fill="#7f97c4"></path>
                      <text x="0" y="9" font-size="6" fill="#7f97c4" text-anchor="middle" font-weight="700">N</text>
                    </g>
                    <!-- truck court (right side, serves loading docks) -->
                    <rect x="294" y="84" width="36" height="146" fill="none" stroke="#a8c2ea" stroke-width="1" stroke-dasharray="4 3"></rect>
                    <g stroke="#a8c2ea" stroke-width="1">
                      <line x1="294" y1="106" x2="330" y2="106"></line><line x1="294" y1="128" x2="330" y2="128"></line><line x1="294" y1="150" x2="330" y2="150"></line><line x1="294" y1="172" x2="330" y2="172"></line><line x1="294" y1="194" x2="330" y2="194"></line>
                    </g>
                    <text x="312" y="157" font-size="6.5" letter-spacing=".5" fill="#7f97c4" text-anchor="middle" font-weight="600" transform="rotate(-90 312 157)">TRUCK COURT</text>
                    <path d="M312,228 L312,212 M308,216 L312,212 L316,216" stroke="#7f97c4" stroke-width="1" fill="none"></path>
                    <!-- front walkway to lobby entrance -->
                    <g stroke="#a8c2ea" stroke-width="1">
                      <line x1="58" y1="236" x2="58" y2="272"></line>
                      <line x1="82" y1="236" x2="82" y2="272"></line>
                      <line x1="58" y1="250" x2="82" y2="250"></line><line x1="58" y1="262" x2="82" y2="262"></line>
                    </g>
                    <!-- front landscaping -->
                    <g stroke="#7fa886" stroke-width="1" fill="none">
                      <circle cx="104" cy="260" r="6"></circle><circle cx="104" cy="260" r="2.4"></circle>
                      <circle cx="126" cy="268" r="5"></circle><circle cx="126" cy="268" r="2"></circle>
                      <circle cx="116" cy="250" r="3"></circle>
                    </g>

                    <!-- ===== STRUCTURAL GRID ===== -->
                    <g stroke="#cdd9ee" stroke-width="1" stroke-dasharray="2 3">
                      <line x1="66" y1="62" x2="66" y2="236"></line><line x1="116" y1="62" x2="116" y2="236"></line><line x1="166" y1="62" x2="166" y2="236"></line><line x1="216" y1="62" x2="216" y2="236"></line><line x1="266" y1="62" x2="266" y2="236"></line>
                      <line x1="30" y1="104" x2="288" y2="104"></line><line x1="30" y1="154" x2="288" y2="154"></line><line x1="30" y1="204" x2="288" y2="204"></line>
                    </g>
                    <g fill="none" stroke="#8ba0c7" stroke-width="1">
                      <circle cx="66" cy="56" r="6"></circle><circle cx="116" cy="56" r="6"></circle><circle cx="166" cy="56" r="6"></circle><circle cx="216" cy="56" r="6"></circle><circle cx="266" cy="56" r="6"></circle>
                      <circle cx="24" cy="104" r="6"></circle><circle cx="24" cy="154" r="6"></circle><circle cx="24" cy="204" r="6"></circle>
                    </g>
                    <g fill="#5f7395" font-size="6.5" font-weight="700" text-anchor="middle" font-family="'IBM Plex Mono', monospace">
                      <text x="66" y="58.5">A</text><text x="116" y="58.5">B</text><text x="166" y="58.5">C</text><text x="216" y="58.5">D</text><text x="266" y="58.5">E</text>
                      <text x="24" y="106.5">1</text><text x="24" y="156.5">2</text><text x="24" y="206.5">3</text>
                    </g>

                    <!-- ===== BUILDING SHELL ===== -->
                    <g stroke="#1e2b49" fill="none">
                      <rect x="40" y="70" width="248" height="166" stroke-width="2.4"></rect>
                      <line x1="116" y1="70" x2="116" y2="236" stroke-width="1.8"></line>
                      <line x1="40" y1="126" x2="116" y2="126" stroke-width="1.4"></line>
                      <line x1="40" y1="190" x2="116" y2="190" stroke-width="1.4"></line>
                    </g>

                    <!-- ===== STEEL FRAMING (girders between columns) ===== -->
                    <g stroke="#c3ccd9" stroke-width="1.2">
                      <line x1="116" y1="104" x2="266" y2="104"></line><line x1="116" y1="154" x2="266" y2="154"></line><line x1="116" y1="204" x2="266" y2="204"></line>
                      <line x1="116" y1="104" x2="116" y2="204"></line><line x1="166" y1="104" x2="166" y2="204"></line><line x1="216" y1="104" x2="216" y2="204"></line><line x1="266" y1="104" x2="266" y2="204"></line>
                    </g>
                    <!-- open-web joists (one representative bay) -->
                    <g stroke="#9fb0cb" stroke-width="0.6">
                      <line x1="223" y1="156" x2="223" y2="202"></line><line x1="230" y1="156" x2="230" y2="202"></line><line x1="237" y1="156" x2="237" y2="202"></line><line x1="244" y1="156" x2="244" y2="202"></line><line x1="251" y1="156" x2="251" y2="202"></line><line x1="258" y1="156" x2="258" y2="202"></line>
                    </g>
                    <!-- columns + spread footings at grid intersections -->
                    <g fill="none" stroke="#b3c1d6" stroke-width="0.8">
                      <rect x="112" y="100" width="8" height="8"></rect><rect x="162" y="100" width="8" height="8"></rect><rect x="212" y="100" width="8" height="8"></rect><rect x="262" y="100" width="8" height="8"></rect>
                      <rect x="112" y="150" width="8" height="8"></rect><rect x="162" y="150" width="8" height="8"></rect><rect x="212" y="150" width="8" height="8"></rect><rect x="262" y="150" width="8" height="8"></rect>
                      <rect x="112" y="200" width="8" height="8"></rect><rect x="162" y="200" width="8" height="8"></rect><rect x="212" y="200" width="8" height="8"></rect><rect x="262" y="200" width="8" height="8"></rect>
                    </g>
                    <g fill="#1e2b49">
                      <rect x="113.8" y="101.8" width="4.4" height="4.4"></rect><rect x="163.8" y="101.8" width="4.4" height="4.4"></rect><rect x="213.8" y="101.8" width="4.4" height="4.4"></rect><rect x="263.8" y="101.8" width="4.4" height="4.4"></rect>
                      <rect x="113.8" y="151.8" width="4.4" height="4.4"></rect><rect x="163.8" y="151.8" width="4.4" height="4.4"></rect><rect x="213.8" y="151.8" width="4.4" height="4.4"></rect><rect x="263.8" y="151.8" width="4.4" height="4.4"></rect>
                      <rect x="113.8" y="201.8" width="4.4" height="4.4"></rect><rect x="163.8" y="201.8" width="4.4" height="4.4"></rect><rect x="213.8" y="201.8" width="4.4" height="4.4"></rect><rect x="263.8" y="201.8" width="4.4" height="4.4"></rect>
                    </g>

                    <!-- office core: stair + landing + up arrow -->
                    <g stroke="#1e2b49" stroke-width="1">
                      <line x1="46" y1="94" x2="72" y2="94"></line><line x1="46" y1="100" x2="72" y2="100"></line><line x1="46" y1="106" x2="72" y2="106"></line><line x1="46" y1="112" x2="72" y2="112"></line><line x1="46" y1="118" x2="72" y2="118"></line>
                      <line x1="59" y1="120" x2="59" y2="90"></line>
                    </g>
                    <path d="M59,88 L55,96 M59,88 L63,96" stroke="#1e2b49" stroke-width="1" fill="none"></path>
                    <!-- mezzanine deck -->
                    <rect x="80" y="80" width="30" height="38" fill="none" stroke="#6f7fa5" stroke-width="1" stroke-dasharray="3 3"></rect>

                    <!-- doors: openings -->
                    <g fill="#fff">
                      <rect x="58" y="234.4" width="24" height="3.4"></rect>
                      <rect x="114.6" y="150" width="3" height="20"></rect>
                    </g>
                    <!-- doors: jambs + leaf + swing arc -->
                    <g stroke="#1e2b49" fill="none">
                      <line x1="58" y1="232" x2="58" y2="240" stroke-width="1.8"></line>
                      <line x1="82" y1="232" x2="82" y2="240" stroke-width="1.8"></line>
                      <line x1="58" y1="236" x2="58" y2="212" stroke-width="1.4"></line>
                      <path d="M58,212 A24,24 0 0,1 82,236" stroke-width="1"></path>
                      <line x1="112" y1="150" x2="120" y2="150" stroke-width="1.8"></line>
                      <line x1="112" y1="170" x2="120" y2="170" stroke-width="1.8"></line>
                      <line x1="116" y1="170" x2="136" y2="170" stroke-width="1.4"></line>
                      <path d="M136,170 A20,20 0 0,0 116,150" stroke-width="1"></path>
                    </g>
                    <!-- loading dock doors (east wall, serves truck court) -->
                    <g stroke="#c96636" stroke-width="2.4">
                      <line x1="288" y1="96" x2="288" y2="114"></line><line x1="288" y1="120" x2="288" y2="138"></line><line x1="288" y1="144" x2="288" y2="162"></line><line x1="288" y1="168" x2="288" y2="186"></line><line x1="288" y1="192" x2="288" y2="210"></line>
                    </g>

                    <!-- room labels -->
                    <g fill="#8b91a7" font-size="7" letter-spacing=".5" font-weight="600" text-anchor="middle">
                      <text x="52" y="108" transform="rotate(-90 52 108)">STAIR</text>
                      <text x="95" y="101">MEZZ</text>
                      <text x="78" y="161">OFFICE &middot; 2-STORY</text>
                      <text x="78" y="216">LOBBY</text>
                      <text x="191" y="176">INTERIOR FLOOR SLAB</text>
                      <text x="278" y="150" fill="#a8623c" transform="rotate(-90 278 150)">LOADING DOCK</text>
                    </g>
                    <text x="191" y="186" font-size="6.5" fill="#aab2bf" text-anchor="middle" font-family="'IBM Plex Mono', monospace">CLEAR HT 36'-0"</text>

                    <!-- ===== TITLE BLOCK (right margin, horizontal, slim) ===== -->
                    <rect x="336" y="8" width="58" height="284" fill="#fff" stroke="#8ba0c7" stroke-width="1"></rect>
                    <g stroke="#8ba0c7" stroke-width="0.8">
                      <line x1="336" y1="52" x2="394" y2="52"></line>
                      <line x1="336" y1="112" x2="394" y2="112"></line>
                      <line x1="336" y1="158" x2="394" y2="158"></line>
                      <line x1="336" y1="198" x2="394" y2="198"></line>
                      <line x1="336" y1="238" x2="394" y2="238"></line>
                    </g>
                    <!-- firm -->
                    <text x="340" y="24" font-size="5.6" font-weight="800" fill="#0f1b2d">ConstructWise</text>
                    <text x="340" y="33" font-size="3.8" letter-spacing=".3" fill="#8b91a7" font-weight="600">GENERAL CONTRACTOR &middot; CM</text>
                    <text x="340" y="41" font-size="3.8" letter-spacing=".3" fill="#8b91a7">LIC. #CR-0 448210</text>
                    <!-- project -->
                    <text x="340" y="63" font-size="3.9" letter-spacing=".4" fill="#aab2bf" font-weight="700">PROJECT</text>
                    <text x="340" y="74" font-size="5.4" font-weight="800" fill="#0f1b2d">COMMERCIAL</text>
                    <text x="340" y="83" font-size="5.4" font-weight="800" fill="#0f1b2d">DISTRIBUTION</text>
                    <text x="340" y="92" font-size="5.4" font-weight="800" fill="#0f1b2d">CENTER</text>
                    <text x="340" y="103" font-size="4" fill="#8b91a7">PHOENIX, AZ 85043</text>
                    <!-- sheet title -->
                    <text x="340" y="124" font-size="3.9" letter-spacing=".4" fill="#aab2bf" font-weight="700">SHEET TITLE</text>
                    <text x="340" y="135" font-size="5.4" font-weight="800" fill="#1e40af">STRUCTURAL</text>
                    <text x="340" y="145" font-size="5.4" font-weight="800" fill="#1e40af">PLAN</text>
                    <!-- admin -->
                    <g font-family="'IBM Plex Mono', monospace" fill="#526581">
                      <text x="340" y="170" font-size="4.2">DRAWN  JRM</text>
                      <text x="340" y="180" font-size="4.2">CHK'D  SR</text>
                      <text x="340" y="190" font-size="4.2">DATE   07 &middot; 2026</text>
                    </g>
                    <!-- scale -->
                    <text x="340" y="211" font-size="3.9" letter-spacing=".4" fill="#aab2bf" font-weight="700">SCALE</text>
                    <text x="340" y="226" font-size="6.4" font-weight="700" fill="#0f1b2d" font-family="'IBM Plex Mono', monospace">1" = 40'-0"</text>
                    <!-- sheet number -->
                    <text x="340" y="252" font-size="3.9" letter-spacing=".4" fill="#aab2bf" font-weight="700">SHEET</text>
                    <text x="390" y="277" font-size="13" font-weight="800" fill="#1e40af" text-anchor="end" font-family="'IBM Plex Mono', monospace">S-101</text>
                  </svg>
                </div>
              </div>

              <!-- ================================================================== -->
              <!-- CARD 2 (SMALL, TOP-RIGHT): PROJECT TOTAL                           -->
              <!-- 360×~245 in mockup ⇒ 38.30% wide, height auto                      -->
              <!-- ================================================================== -->
              <div style="position: absolute; right: 0; top: 0; width: 40%; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 22px; box-shadow: 0 8px 32px rgba(15,27,45,0.05); padding: 3.78% 4.15%; box-sizing: border-box; z-index: 2;">
                <div style="font-size: 1.17cqw; font-weight: 700; letter-spacing: 1.2px; color: #64748b;">PROJECT TOTAL</div>
                <div style="font-size: 3.40cqw; font-weight: 800; letter-spacing: -1.5px; color: #0f1b2d; margin-top: 0.6%;">$42,680,000</div>
                <div style="font-size: 1.49cqw; color: #94a3b8; margin-top: 0.2%;">Hard cost &middot; GMP &middot; GRs &amp; GCs</div>
                <div style="display: flex; justify-content: space-between; align-items: baseline; margin-top: 1.7%;">
                  <span style="font-size: 1.17cqw; font-weight: 700; letter-spacing: 1px; color: #64748b;">BUDGET CONFIDENCE</span>
                  <span style="font-size: 1.49cqw; font-weight: 700; color: #22c55e;">92%</span>
                </div>
                <div style="height: 0.85cqw; border-radius: 4px; background: #e2e8f0; margin-top: 0.85%; overflow: hidden;">
                  <div style="width: 92%; height: 100%; background: #22c55e; border-radius: 4px;"></div>
                </div>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingNav from '../components/landing/LandingNav.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
---
<BaseLayout>
  <div class="min-h-screen bg-gradient-to-b from-slate-50 to-white pt-20">
    <LandingNav />

    <section class="pt-12 md:pt-16 pb-16 px-4">
      <div class="container mx-auto max-w-7xl">

        <!-- Two-column hero: text + interactive graphic -->
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center mb-14 md:mb-16">

          <!-- Left: text content -->
          <div class="text-center lg:text-left">
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-7 leading-[1.05]">
              Intelligent Bid Estimation &amp; Schedule Planning{" "}
              <span class="text-blue-600">for the Construction Industry</span>
            </h1>
            <p class="text-lg md:text-xl text-gray-700 mb-9 leading-relaxed font-medium">
              ConstructWise is the shared brain of your construction business &mdash; recording every bid, schedule, and hard-won decision so every estimator, project manager, and executive operates with the collective instinct of the people they work with.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
              <a
                href="/pricing"
                class="inline-flex items-center justify-center rounded-md text-lg px-8 py-3 h-12 bg-blue-600 text-white hover:bg-blue-700 transition-colors duration-300 font-semibold shadow-sm"
              >
                Get started &rarr;
              </a>
              <a
                href="/solutions"
                class="inline-flex items-center justify-center rounded-md text-lg px-8 py-3 h-12 bg-white border border-blue-600 text-blue-600 hover:bg-blue-50 transition-colors duration-300 font-semibold"
              >
                See what's included
              </a>
            </div>
          </div>

          <!-- Right: animated hero graphic -->
          <div class="relative hero-graphic-wrap">
            <!-- ambient glow -->
            <div class="absolute -inset-4 bg-gradient-to-br from-blue-100 via-indigo-50 to-transparent rounded-3xl blur-2xl opacity-70 pointer-events-none"></div>

            <svg viewBox="0 0 560 520" xmlns="http://www.w3.org/2000/svg" class="relative w-full h-auto drop-shadow-2xl hero-svg">
              <defs>
                <linearGradient id="cardGrad" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#ffffff"/>
                  <stop offset="1" stop-color="#f8fafc"/>
                </linearGradient>
                <linearGradient id="brandGrad" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0" stop-color="#2563eb"/>
                  <stop offset="1" stop-color="#4f46e5"/>
                </linearGradient>
                <pattern id="bp" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
                  <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#dbeafe" stroke-width="0.5"/>
                </pattern>
                <style>
                  .pulse-ring { transform-origin: 470px 76px; animation: pulseRing 2.4s ease-out infinite; }
                  .pulse-dot  { transform-origin: 470px 76px; animation: pulseDot 2.4s ease-out infinite; }
                  @keyframes pulseRing { 0% { transform: scale(0.6); opacity: 0.85; } 100% { transform: scale(1.9); opacity: 0; } }
                  @keyframes pulseDot  { 0%, 70% { opacity: 1; } 100% { opacity: 1; } }

                  .flow-dot { animation: flow 3.2s linear infinite; }
                  .flow-dot.d2 { animation-delay: 1.1s; }
                  .flow-dot.d3 { animation-delay: 2.2s; }
                  @keyframes flow {
                    0%   { offset-distance: 0%;   opacity: 0; }
                    10%  { opacity: 1; }
                    90%  { opacity: 1; }
                    100% { offset-distance: 100%; opacity: 0; }
                  }

                  .bar-fill { transform-origin: left center; animation: barFill 3.8s ease-out infinite; }
                  @keyframes barFill {
                    0%, 100% { transform: scaleX(0.88); }
                    50%      { transform: scaleX(1); }
                  }

                  .counter { animation: countFade 4s ease-in-out infinite; }
                  @keyframes countFade {
                    0%, 100% { opacity: 1; }
                    50%      { opacity: 0.75; }
                  }
                </style>
              </defs>

              <!-- Background blueprint grid in soft circle -->
              <circle cx="280" cy="260" r="240" fill="url(#bp)" opacity="0.7"/>

              <!-- ============================== -->
              <!-- TOP-LEFT: STYLIZED FLOOR PLAN -->
              <!-- ============================== -->
              <g transform="translate(40, 60)">
                <rect width="220" height="200" rx="14" fill="url(#cardGrad)" stroke="#e2e8f0" stroke-width="1"/>
                <!-- Card header -->
                <text x="16" y="22" font-family="system-ui" font-size="9" font-weight="700" fill="#94a3b8" letter-spacing="1">SCHEMATIC PLAN</text>

                <!-- =========== OUTER WALLS WITH OPENINGS =========== -->
                <!-- Top wall y=40 — broken for two windows -->
                <line x1="28"  y1="40" x2="44"  y2="40" stroke="#1e3a5f" stroke-width="2"/>
                <line x1="74"  y1="40" x2="122" y2="40" stroke="#1e3a5f" stroke-width="2"/>
                <line x1="152" y1="40" x2="192" y2="40" stroke="#1e3a5f" stroke-width="2"/>
                <!-- BR1 window: 3 parallel lines -->
                <line x1="44" y1="38.5" x2="74" y2="38.5" stroke="#1e3a5f" stroke-width="0.6"/>
                <line x1="44" y1="40"   x2="74" y2="40"   stroke="#1e3a5f" stroke-width="0.6"/>
                <line x1="44" y1="41.5" x2="74" y2="41.5" stroke="#1e3a5f" stroke-width="0.6"/>
                <!-- BR2 window: 3 parallel lines -->
                <line x1="122" y1="38.5" x2="152" y2="38.5" stroke="#1e3a5f" stroke-width="0.6"/>
                <line x1="122" y1="40"   x2="152" y2="40"   stroke="#1e3a5f" stroke-width="0.6"/>
                <line x1="122" y1="41.5" x2="152" y2="41.5" stroke="#1e3a5f" stroke-width="0.6"/>

                <!-- Right wall x=192 (solid) -->
                <line x1="192" y1="40" x2="192" y2="180" stroke="#1e3a5f" stroke-width="2"/>

                <!-- Bottom wall y=180 — broken for living-room window + front-entry door -->
                <line x1="28"  y1="180" x2="60"  y2="180" stroke="#1e3a5f" stroke-width="2"/>
                <line x1="90"  y1="180" x2="120" y2="180" stroke="#1e3a5f" stroke-width="2"/>
                <line x1="132" y1="180" x2="192" y2="180" stroke="#1e3a5f" stroke-width="2"/>
                <!-- LIVING window -->
                <line x1="60" y1="178.5" x2="90" y2="178.5" stroke="#1e3a5f" stroke-width="0.6"/>
                <line x1="60" y1="180"   x2="90" y2="180"   stroke="#1e3a5f" stroke-width="0.6"/>
                <line x1="60" y1="181.5" x2="90" y2="181.5" stroke="#1e3a5f" stroke-width="0.6"/>
                <!-- Front-entry door: hinged at x=120, panel swings up into LIVING -->
                <line x1="120" y1="180" x2="120" y2="168" stroke="#1e3a5f" stroke-width="1"/>
                <path d="M 120 168 A 12 12 0 0 0 132 180" stroke="#94a3b8" stroke-width="0.7" fill="none"/>

                <!-- Left wall x=28 (solid) -->
                <line x1="28" y1="40" x2="28" y2="180" stroke="#1e3a5f" stroke-width="2"/>

                <!-- =========== INTERIOR WALLS WITH DOORS =========== -->
                <!-- Vertical wall x=108, y=40-98 (BR1 / BR2 partition, solid) -->
                <line x1="108" y1="40" x2="108" y2="98" stroke="#1e3a5f" stroke-width="1.5"/>

                <!-- Horizontal wall y=98 — bedrooms to living. Two door openings. -->
                <line x1="28"  y1="98" x2="48"  y2="98" stroke="#1e3a5f" stroke-width="1.5"/>
                <line x1="60"  y1="98" x2="128" y2="98" stroke="#1e3a5f" stroke-width="1.5"/>
                <line x1="140" y1="98" x2="152" y2="98" stroke="#1e3a5f" stroke-width="1.5"/>
                <!-- BR1 door: hinge at x=48, swings down into LIVING -->
                <line x1="48" y1="98" x2="48" y2="110" stroke="#1e3a5f" stroke-width="1"/>
                <path d="M 48 110 A 12 12 0 0 1 60 98" stroke="#94a3b8" stroke-width="0.7" fill="none"/>
                <!-- BR2 door: hinge at x=140, swings down into LIVING -->
                <line x1="140" y1="98" x2="140" y2="110" stroke="#1e3a5f" stroke-width="1"/>
                <path d="M 140 110 A 12 12 0 0 0 128 98" stroke="#94a3b8" stroke-width="0.7" fill="none"/>

                <!-- Vertical wall x=152, y=98-180 — living to bath/kitchen. Two door openings. -->
                <line x1="152" y1="98"  x2="152" y2="108" stroke="#1e3a5f" stroke-width="1.5"/>
                <line x1="152" y1="120" x2="152" y2="156" stroke="#1e3a5f" stroke-width="1.5"/>
                <line x1="152" y1="168" x2="152" y2="180" stroke="#1e3a5f" stroke-width="1.5"/>
                <!-- BATH door: hinge at y=108, swings right into BATH -->
                <line x1="152" y1="108" x2="164" y2="108" stroke="#1e3a5f" stroke-width="1"/>
                <path d="M 164 108 A 12 12 0 0 1 152 120" stroke="#94a3b8" stroke-width="0.7" fill="none"/>
                <!-- KIT door: hinge at y=168, swings right into KIT -->
                <line x1="152" y1="168" x2="164" y2="168" stroke="#1e3a5f" stroke-width="1"/>
                <path d="M 164 168 A 12 12 0 0 0 152 156" stroke="#94a3b8" stroke-width="0.7" fill="none"/>

                <!-- Horizontal wall y=138 — bath / kitchen partition (solid) -->
                <line x1="152" y1="138" x2="192" y2="138" stroke="#1e3a5f" stroke-width="1.5"/>

                <!-- =========== ROOM LABELS =========== -->
                <text x="68"  y="72"  font-family="system-ui" font-size="7" font-weight="600" fill="#64748b" text-anchor="middle">BR-1</text>
                <text x="150" y="72"  font-family="system-ui" font-size="7" font-weight="600" fill="#64748b" text-anchor="middle">BR-2</text>
                <text x="88"  y="138" font-family="system-ui" font-size="7" font-weight="600" fill="#64748b" text-anchor="middle">LIVING</text>
                <text x="172" y="105" font-family="system-ui" font-size="6" font-weight="600" fill="#64748b" text-anchor="middle">BATH</text>
                <text x="172" y="148" font-family="system-ui" font-size="6" font-weight="600" fill="#64748b" text-anchor="middle">KIT</text>

                <!-- =========== BATH FIXTURES =========== -->
                <!-- Tub: rounded rect along the right wall -->
                <rect x="178" y="112" width="12" height="20" rx="2" fill="none" stroke="#94a3b8" stroke-width="0.6"/>
                <circle cx="184" cy="129" r="1.2" fill="none" stroke="#94a3b8" stroke-width="0.5"/>
                <!-- Toilet: tank rect + bowl ellipse -->
                <rect x="156" y="114" width="6" height="3" fill="none" stroke="#94a3b8" stroke-width="0.6"/>
                <ellipse cx="159" cy="121" rx="3" ry="3.5" fill="none" stroke="#94a3b8" stroke-width="0.6"/>
                <!-- Sink: small basin -->
                <rect x="156" y="128" width="9" height="6" rx="1" fill="none" stroke="#94a3b8" stroke-width="0.6"/>
                <circle cx="160.5" cy="131" r="1" fill="none" stroke="#94a3b8" stroke-width="0.5"/>

                <!-- =========== KITCHEN FIXTURES =========== -->
                <!-- Counter / range with four burners -->
                <rect x="156" y="156" width="18" height="14" rx="1" fill="none" stroke="#94a3b8" stroke-width="0.6"/>
                <circle cx="160" cy="160" r="1.2" fill="none" stroke="#94a3b8" stroke-width="0.5"/>
                <circle cx="170" cy="160" r="1.2" fill="none" stroke="#94a3b8" stroke-width="0.5"/>
                <circle cx="160" cy="166" r="1.2" fill="none" stroke="#94a3b8" stroke-width="0.5"/>
                <circle cx="170" cy="166" r="1.2" fill="none" stroke="#94a3b8" stroke-width="0.5"/>
                <!-- Refrigerator -->
                <rect x="178" y="156" width="11" height="14" rx="1" fill="none" stroke="#94a3b8" stroke-width="0.6"/>
                <line x1="178" y1="160" x2="189" y2="160" stroke="#94a3b8" stroke-width="0.4"/>
              </g>

              <!-- ============================== -->
              <!-- TOP-RIGHT: BID TOTAL CARD     -->
              <!-- ============================== -->
              <g transform="translate(296, 60)">
                <rect width="224" height="200" rx="14" fill="url(#cardGrad)" stroke="#e2e8f0" stroke-width="1"/>
                <text x="16" y="22" font-family="system-ui" font-size="9" font-weight="700" fill="#94a3b8" letter-spacing="1">PROJECT TOTAL</text>
                <!-- Big number -->
                <text x="16" y="64" font-family="system-ui" font-size="28" font-weight="800" fill="#1e3a5f" class="counter">$2,847,500</text>
                <text x="16" y="82" font-family="system-ui" font-size="10" fill="#64748b">Hard cost &middot; GMP &middot; GRs &amp; GCs</text>

                <!-- Confidence bar -->
                <text x="16" y="112" font-family="system-ui" font-size="9" font-weight="600" fill="#475569" letter-spacing="0.5">BUDGET CONFIDENCE</text>
                <text x="200" y="112" font-family="system-ui" font-size="9" font-weight="700" fill="#16a34a" text-anchor="end">94%</text>
                <rect x="16" y="118" width="192" height="6" rx="3" fill="#e2e8f0"/>
                <rect x="16" y="118" width="192" height="6" rx="3" fill="#22c55e" class="bar-fill"/>

                <!-- Mini breakdown rows -->
                <g transform="translate(16, 138)">
                  <rect x="0"   y="0"  width="60" height="50" rx="8" fill="#eff6ff"/>
                  <text x="8"   y="14" font-family="system-ui" font-size="7" font-weight="700" fill="#2563eb" letter-spacing="0.5">CONCRETE</text>
                  <text x="8"   y="34" font-family="system-ui" font-size="12" font-weight="700" fill="#1e3a5f">$453K</text>

                  <rect x="68"  y="0"  width="60" height="50" rx="8" fill="#eff6ff"/>
                  <text x="76"  y="14" font-family="system-ui" font-size="7" font-weight="700" fill="#2563eb" letter-spacing="0.5">STEEL</text>
                  <text x="76"  y="34" font-family="system-ui" font-size="12" font-weight="700" fill="#1e3a5f">$781K</text>

                  <rect x="136" y="0"  width="60" height="50" rx="8" fill="#eff6ff"/>
                  <text x="144" y="14" font-family="system-ui" font-size="7" font-weight="700" fill="#2563eb" letter-spacing="0.5">MEP</text>
                  <text x="144" y="34" font-family="system-ui" font-size="12" font-weight="700" fill="#1e3a5f">$920K</text>
                </g>
              </g>

              <!-- ============================== -->
              <!-- BOTTOM: GANTT TIMELINE        -->
              <!-- ============================== -->
              <g transform="translate(40, 280)">
                <rect width="480" height="210" rx="14" fill="url(#cardGrad)" stroke="#e2e8f0" stroke-width="1"/>
                <text x="16" y="22" font-family="system-ui" font-size="9" font-weight="700" fill="#94a3b8" letter-spacing="1">CPM SCHEDULE &middot; CRITICAL PATH</text>

                <!-- Live collaborators (top-right) -->
                <g transform="translate(380, 12)">
                  <circle cx="6" cy="10" r="3" fill="#22c55e"/>
                  <circle cx="6" cy="10" r="3" fill="#22c55e" opacity="0.4" class="pulse-dot"/>
                  <text x="14" y="13" font-family="system-ui" font-size="8" font-weight="600" fill="#16a34a" letter-spacing="0.3">LIVE</text>
                  <!-- Avatar stack -->
                  <circle cx="48" cy="10" r="7" fill="#3b82f6" stroke="white" stroke-width="1.5"/>
                  <text x="48" y="13" font-family="system-ui" font-size="6.5" font-weight="700" fill="white" text-anchor="middle">JM</text>
                  <circle cx="60" cy="10" r="7" fill="#a855f7" stroke="white" stroke-width="1.5"/>
                  <text x="60" y="13" font-family="system-ui" font-size="6.5" font-weight="700" fill="white" text-anchor="middle">SR</text>
                  <circle cx="72" cy="10" r="7" fill="#f59e0b" stroke="white" stroke-width="1.5"/>
                  <text x="72" y="13" font-family="system-ui" font-size="6.5" font-weight="700" fill="white" text-anchor="middle">TK</text>
                  <circle cx="84" cy="10" r="7" fill="#e2e8f0" stroke="white" stroke-width="1.5"/>
                  <text x="84" y="13" font-family="system-ui" font-size="6" font-weight="700" fill="#64748b" text-anchor="middle">+9</text>
                </g>

                <!-- Month markers -->
                <text x="16" y="42" font-family="system-ui" font-size="8" fill="#94a3b8">JAN</text>
                <text x="76" y="42" font-family="system-ui" font-size="8" fill="#94a3b8">FEB</text>
                <text x="136" y="42" font-family="system-ui" font-size="8" fill="#94a3b8">MAR</text>
                <text x="196" y="42" font-family="system-ui" font-size="8" fill="#94a3b8">APR</text>
                <text x="256" y="42" font-family="system-ui" font-size="8" fill="#94a3b8">MAY</text>
                <text x="316" y="42" font-family="system-ui" font-size="8" fill="#94a3b8">JUN</text>
                <text x="376" y="42" font-family="system-ui" font-size="8" fill="#94a3b8">JUL</text>
                <text x="436" y="42" font-family="system-ui" font-size="8" fill="#94a3b8">AUG</text>

                <!-- Subtle column dividers -->
                <line x1="74"  y1="48" x2="74"  y2="160" stroke="#f1f5f9"/>
                <line x1="134" y1="48" x2="134" y2="160" stroke="#f1f5f9"/>
                <line x1="194" y1="48" x2="194" y2="160" stroke="#f1f5f9"/>
                <line x1="254" y1="48" x2="254" y2="160" stroke="#f1f5f9"/>
                <line x1="314" y1="48" x2="314" y2="160" stroke="#f1f5f9"/>
                <line x1="374" y1="48" x2="374" y2="160" stroke="#f1f5f9"/>
                <line x1="434" y1="48" x2="434" y2="160" stroke="#f1f5f9"/>

                <!-- Activity bars (critical path red, float blue) -->
                <rect x="16"  y="58"  width="78"  height="14" rx="4" fill="#ef4444"/>
                <text x="20"  y="68"  font-family="system-ui" font-size="7" fill="white" font-weight="600">Site Prep</text>
                <circle cx="90"  cy="65"  r="4" fill="#3b82f6" stroke="white" stroke-width="1"/>

                <rect x="80"  y="78"  width="100" height="14" rx="4" fill="#ef4444"/>
                <text x="84"  y="88"  font-family="system-ui" font-size="7" fill="white" font-weight="600">Foundation</text>
                <circle cx="176" cy="85"  r="4" fill="#a855f7" stroke="white" stroke-width="1"/>

                <rect x="160" y="98"  width="130" height="14" rx="4" fill="#ef4444"/>
                <text x="164" y="108" font-family="system-ui" font-size="7" fill="white" font-weight="600">Structural Steel</text>
                <circle cx="286" cy="105" r="4" fill="#f59e0b" stroke="white" stroke-width="1"/>

                <rect x="220" y="118" width="120" height="14" rx="4" fill="#60a5fa"/>
                <text x="224" y="128" font-family="system-ui" font-size="7" fill="white" font-weight="600">MEP Rough-In</text>
                <circle cx="336" cy="125" r="4" fill="#3b82f6" stroke="white" stroke-width="1"/>

                <rect x="300" y="138" width="120" height="14" rx="4" fill="#60a5fa"/>
                <text x="304" y="148" font-family="system-ui" font-size="7" fill="white" font-weight="600">Envelope</text>
                <circle cx="416" cy="145" r="4" fill="#a855f7" stroke="white" stroke-width="1"/>

                <!-- Legend -->
                <rect x="220" y="20" width="8" height="8" rx="2" fill="#ef4444"/>
                <text x="232" y="27" font-family="system-ui" font-size="8" fill="#64748b">Critical</text>
                <rect x="270" y="20" width="8" height="8" rx="2" fill="#60a5fa"/>
                <text x="282" y="27" font-family="system-ui" font-size="8" fill="#64748b">Float</text>

                <!-- AI learning footer strip -->
                <line x1="0" y1="170" x2="480" y2="170" stroke="#e2e8f0"/>
                <g transform="translate(16, 180)">
                  <!-- spark/brain icon -->
                  <circle cx="9" cy="11" r="9" fill="url(#brandGrad)"/>
                  <path d="M 6 9 L 9 6 L 12 9 M 6 13 L 9 16 L 12 13 M 9 7 L 9 15" stroke="white" stroke-width="1.2" stroke-linecap="round" fill="none"/>
                  <text x="26" y="9" font-family="system-ui" font-size="8" font-weight="700" fill="#1e3a5f" letter-spacing="0.3">COLLABORATIVE SCHEDULING</text>
                  <text x="26" y="20" font-family="system-ui" font-size="8" fill="#64748b">AI learning from <tspan font-weight="700" fill="#2563eb">247 similar schedules</tspan> across your firm</text>
                </g>
              </g>

              <!-- ============================== -->
              <!-- FLOATING AI BADGE (pulses)    -->
              <!-- ============================== -->
              <g>
                <circle cx="470" cy="76" r="28" fill="#3b82f6" opacity="0.15" class="pulse-ring"/>
                <circle cx="470" cy="76" r="22" fill="url(#brandGrad)" class="pulse-dot"/>
                <text x="470" y="73" font-family="system-ui" font-size="8" font-weight="700" fill="white" text-anchor="middle" letter-spacing="0.5">AI</text>
                <text x="470" y="84" font-family="system-ui" font-size="6" font-weight="600" fill="white" text-anchor="middle" letter-spacing="0.3" opacity="0.95">INSIGHT</text>
              </g>

              <!-- ============================== -->
              <!-- DATA-FLOW DOTS  (plan → bid)  -->
              <!-- ============================== -->
              <!-- path: 260 (right edge of plan card) -> 296 (left edge of bid card), arcing slightly -->
              <circle r="3" fill="#2563eb" class="flow-dot" style="offset-path: path('M 260 160 Q 278 130 296 160');"/>
              <circle r="3" fill="#4f46e5" class="flow-dot d2" style="offset-path: path('M 260 160 Q 278 130 296 160');"/>
              <circle r="3" fill="#2563eb" class="flow-dot d3" style="offset-path: path('M 260 160 Q 278 130 296 160');"/>

              <!-- Data-flow from bid → schedule -->
              <circle r="3" fill="#2563eb" class="flow-dot"    style="offset-path: path('M 408 260 Q 280 270 280 280');"/>
              <circle r="3" fill="#4f46e5" class="flow-dot d2" style="offset-path: path('M 408 260 Q 280 270 280 280');"/>

            </svg>
          </div>

        </div>

        <!-- KPIs banner -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto mb-12">
          <div class="text-center">
            <div class="text-5xl font-bold text-blue-600 mb-3">5x</div>
            <div class="text-gray-600 leading-relaxed">Faster bids. More hours back for the work only builders can do.</div>
          </div>
          <div class="text-center">
            <div class="text-5xl font-bold text-blue-600 mb-3">15%</div>
            <div class="text-gray-600 leading-relaxed">Higher win rates when teams bid with dynamic data, not a stale price book.</div>
          </div>
          <div class="text-center">
            <div class="text-5xl font-bold text-blue-600 mb-3">20%</div>

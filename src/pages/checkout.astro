---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingNav from '../components/landing/LandingNav.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';

const FINIX_APPLICATION_ID = import.meta.env.PUBLIC_FINIX_APPLICATION_ID;
const FINIX_ENVIRONMENT = import.meta.env.PUBLIC_FINIX_ENVIRONMENT || 'sandbox';
const HCAPTCHA_SITE_KEY = import.meta.env.PUBLIC_HCAPTCHA_SITE_KEY;
const BACKEND_URL = import.meta.env.PUBLIC_BACKEND_URL || 'https://api.constructwise.ai';
---
<BaseLayout title="Checkout - ConstructWise">
  <!-- Finix Hosted Fields tokenizer + hCaptcha (both browser-side) -->
  <script is:inline src="https://js.finix.com/v/1/finix.js"></script>
  <script is:inline src="https://js.hcaptcha.com/1/api.js?render=explicit" async defer></script>

  <div class="min-h-screen bg-gray-50 pt-16">
    <LandingNav />

    <section class="py-16 px-4">
      <div class="container mx-auto max-w-5xl">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-8">

          <!-- Order Summary (right on desktop, top on mobile) -->
          <div class="lg:col-span-2 lg:order-2">
            <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm sticky top-24">
              <h2 class="text-lg font-bold text-gray-900 mb-4">Order Summary</h2>

              <div class="space-y-4">
                <div class="flex items-center justify-between">
                  <div>
                    <p id="summaryPlanName" class="font-semibold text-gray-900">--</p>
                    <p id="summaryCadence" class="text-sm text-gray-500">--</p>
                  </div>
                  <span id="summaryTokens" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700">--</span>
                </div>
                <div class="flex justify-between text-sm text-gray-500">
                  <span>1 seat to start</span>
                  <span id="summaryPerSeat">--</span>
                </div>
              </div>

              <div class="border-t border-gray-100 mt-6 pt-4 space-y-2">
                <div class="flex justify-between text-sm text-gray-600">
                  <span>Subtotal</span>
                  <span id="subtotal" class="font-medium">--</span>
                </div>
                <div class="border-t border-gray-100 pt-3 flex justify-between text-base font-bold text-gray-900">
                  <span>Due today</span>
                  <span id="total">--</span>
                </div>
              </div>

              <p class="text-xs text-gray-500 mt-4">
                Add more seats anytime from your account settings — you'll be charged a
                prorated amount per added seat.
              </p>
            </div>
          </div>

          <!-- Checkout Form -->
          <div class="lg:col-span-3 lg:order-1">
            <div class="mb-6">
              <a href="/pricing" class="text-sm text-blue-600 hover:text-blue-800 flex items-center gap-1">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
                Back to Pricing
              </a>
            </div>

            <h1 class="text-3xl font-bold text-gray-900 mb-8">Complete your signup</h1>

            <form id="checkoutForm" class="space-y-8">
              <!-- Account Information -->
              <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm">
                <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
                  <span class="flex items-center justify-center w-6 h-6 rounded-full bg-blue-600 text-white text-xs font-bold">1</span>
                  Account Information
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label for="firstName" class="block text-sm font-medium text-gray-700 mb-1">First Name</label>
                    <input type="text" id="firstName" name="firstName" required
                      class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-colors" />
                  </div>
                  <div>
                    <label for="lastName" class="block text-sm font-medium text-gray-700 mb-1">Last Name</label>
                    <input type="text" id="lastName" name="lastName" required
                      class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-colors" />
                  </div>
                  <div class="sm:col-span-2">
                    <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Work Email</label>
                    <input type="email" id="email" name="email" required
                      class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-colors" />
                  </div>
                  <div class="sm:col-span-2">
                    <label for="company" class="block text-sm font-medium text-gray-700 mb-1">Company Name</label>
                    <input type="text" id="company" name="company" required
                      class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-colors" />
                  </div>
                  <div>
                    <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Phone Number</label>
                    <input type="tel" id="phone" name="phone"
                      class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-colors" />
                  </div>
                  <div></div>
                  <div>
                    <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Password</label>
                    <input type="password" id="password" name="password" required minlength="8" maxlength="72"
                      autocomplete="new-password"
                      class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-colors" />
                    <p class="mt-1 text-xs text-gray-500">8 characters or more</p>
                  </div>
                  <div>
                    <label for="passwordConfirm" class="block text-sm font-medium text-gray-700 mb-1">Confirm Password</label>
                    <input type="password" id="passwordConfirm" name="passwordConfirm" required
                      autocomplete="new-password"
                      class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-colors" />
                  </div>
                </div>
              </div>

              <!-- Payment Information -->
              <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm">
                <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
                  <span class="flex items-center justify-center w-6 h-6 rounded-full bg-blue-600 text-white text-xs font-bold">2</span>
                  Payment Information
                </h3>

                <!-- Finix Hosted Fields mount points (iframe-isolated; PCI-safe) -->
                <div id="finix-card-number" class="mb-3 rounded-lg border border-gray-300 px-4 py-2.5"></div>
                <div class="grid grid-cols-2 gap-3">
                  <div id="finix-card-expiration" class="rounded-lg border border-gray-300 px-4 py-2.5"></div>
                  <div id="finix-card-cvc" class="rounded-lg border border-gray-300 px-4 py-2.5"></div>
                </div>

                <p class="text-xs text-gray-500 mt-3 flex items-center gap-1">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" /></svg>
                  Powered by Finix — your card data is encrypted in transit and never touches our servers
                </p>
              </div>

              <!-- Billing Address -->
              <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm">
                <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
                  <span class="flex items-center justify-center w-6 h-6 rounded-full bg-blue-600 text-white text-xs font-bold">3</span>
                  Billing Address
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div class="sm:col-span-2">
                    <label for="address" class="block text-sm font-medium text-gray-700 mb-1">Street Address</label>
                    <input type="text" id="address" name="address" required
                      class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-colors" />
                  </div>
                  <div>
                    <label for="city" class="block text-sm font-medium text-gray-700 mb-1">City</label>
                    <input type="text" id="city" name="city" required
                      class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-colors" />
                  </div>
                  <div>
                    <label for="state" class="block text-sm font-medium text-gray-700 mb-1">State</label>
                    <input type="text" id="state" name="state" required maxlength="2"
                      placeholder="NY"
                      class="w-full uppercase rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-colors" />
                  </div>
                  <div>
                    <label for="zip" class="block text-sm font-medium text-gray-700 mb-1">ZIP Code</label>
                    <input type="text" id="zip" name="zip" required pattern="[0-9]{5}"
                      class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-colors" />
                  </div>
                  <div>
                    <label for="country" class="block text-sm font-medium text-gray-700 mb-1">Country</label>
                    <select id="country" name="country"
                      class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-colors bg-white">
                      <option value="US">United States</option>
                    </select>
                  </div>
                </div>
              </div>

              <!-- hCaptcha widget (invisible) -->
              <div id="hcaptcha-widget" class="h-captcha" data-sitekey={HCAPTCHA_SITE_KEY} data-size="invisible"></div>

              <!-- Inline error display -->
              <div id="formError" class="hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>

              <!-- Submit -->
              <button type="submit" id="submitBtn"
                class="w-full rounded-lg bg-blue-600 py-4 text-base font-semibold text-white hover:bg-blue-700 transition-colors flex items-center justify-center gap-2 disabled:opacity-60 disabled:cursor-not-allowed">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" /></svg>
                <span id="submitText">Subscribe &mdash; Pay Now</span>
              </button>

              <p class="text-xs text-center text-gray-400">
                By subscribing, you agree to our Terms of Service and Privacy Policy.
                <br />You can cancel anytime from your account settings.
              </p>
            </form>
          </div>

        </div>
      </div>
    </section>

    <LandingFooter />
  </div>

  <script
    is:inline
    define:vars={{ FINIX_APPLICATION_ID, FINIX_ENVIRONMENT, HCAPTCHA_SITE_KEY, BACKEND_URL }}
  >
    // ---------------------------------------------------------------
    // Pricing — MUST match backend/src/config/billingPricing.ts in the
    // constructwise-ai repo. Any change here also belongs there.
    // ---------------------------------------------------------------
    const plans = {
      foundation: { name: 'Foundation', monthly: 349, annual: 300, annualTotal: 3600, tokens: '1,000,000' },
      podium:     { name: 'Podium',     monthly: 649, annual: 600, annualTotal: 7200, tokens: '3,000,000' },
    };

    const params = new URLSearchParams(window.location.search);
    const planKey = params.get('plan') || 'foundation';
    const billing = params.get('billing') || 'annual';
    const plan = plans[planKey] || plans.foundation;
    const isAnnual = billing === 'annual';
    const pricePerUser = isAnnual ? plan.annual : plan.monthly;

    // ---- Order summary --------------------------------------------
    // Use textContent (not innerHTML) — these values come from a static plans
    // map but textContent is XSS-safe by construction.
    function setText(id, value) {
      const el = document.getElementById(id);
      if (el) el.textContent = value;
    }
    setText('summaryPlanName', `${plan.name} Plan`);
    setText('summaryCadence', `${isAnnual ? 'Annual' : 'Monthly'} billing`);
    setText('summaryTokens', `${plan.tokens} tokens/mo`);
    setText('summaryPerSeat', `$${pricePerUser}/${isAnnual ? 'mo (billed annually)' : 'mo'}`);

    if (isAnnual) {
      const yr = plan.annualTotal;
      setText('subtotal', `$${yr.toLocaleString()}/yr`);
      setText('total', `$${yr.toLocaleString()}`);
      setText('submitText', `Subscribe — $${yr.toLocaleString()}/yr`);
    } else {
      const m = plan.monthly;
      setText('subtotal', `$${m.toLocaleString()}/mo`);
      setText('total', `$${m.toLocaleString()}`);
      setText('submitText', `Subscribe — $${m.toLocaleString()}/mo`);
    }

    // ---- Finix Hosted Fields --------------------------------------
    let finixForm = null;
    function initFinix() {
      if (typeof Finix === 'undefined') {
        setTimeout(initFinix, 100);
        return;
      }
      // The browser SDK exposes `Finix.CardTokenForm(applicationId, options)`.
      finixForm = Finix.CardTokenForm('finix-form-mount', {
        showAddress: false,
        applicationId: FINIX_APPLICATION_ID,
        environment: FINIX_ENVIRONMENT,
        styles: {
          default: { color: '#0f172a', fontSize: '14px', fontFamily: 'system-ui, sans-serif' },
        },
      });
    }
    initFinix();

    // ---- hCaptcha helper ------------------------------------------
    function getHCaptchaToken() {
      return new Promise((resolve, reject) => {
        if (typeof hcaptcha === 'undefined' || !HCAPTCHA_SITE_KEY) {
          // No captcha configured — backend's verifyHCaptcha returns true in dev.
          resolve('dev-no-captcha');
          return;
        }
        try {
          hcaptcha.execute('hcaptcha-widget', { async: true })
            .then((r) => resolve(r.response))
            .catch(reject);
        } catch (e) { reject(e); }
      });
    }

    // ---- Form submit ----------------------------------------------
    const form = document.getElementById('checkoutForm');
    const submitBtn = document.getElementById('submitBtn');
    const errorEl = document.getElementById('formError');

    function showError(message) {
      if (!errorEl) return;
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
    }
    function hideError() {
      errorEl?.classList.add('hidden');
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideError();
      submitBtn?.setAttribute('disabled', 'true');

      try {
        const passwordEl = document.getElementById('password');
        const confirmEl = document.getElementById('passwordConfirm');
        if (passwordEl?.value !== confirmEl?.value) {
          throw new Error("Passwords don't match");
        }

        // 1. Tokenize the card via Finix Hosted Fields.
        if (!finixForm) throw new Error('Payment form not ready yet — please wait a moment');
        const tokenResp = await new Promise((resolve, reject) => {
          finixForm.submit((err, response) => {
            if (err) reject(err);
            else resolve(response);
          });
        });
        const finixPaymentToken = tokenResp?.data?.id;
        if (!finixPaymentToken) throw new Error('Could not tokenize card');

        // 2. hCaptcha.
        const hcaptchaToken = await getHCaptchaToken();

        // 3. POST to backend signup endpoint.
        const payload = {
          account: {
            first_name: document.getElementById('firstName').value.trim(),
            last_name: document.getElementById('lastName').value.trim(),
            email: document.getElementById('email').value.trim(),
            password: passwordEl.value,
            phone: document.getElementById('phone').value.trim() || undefined,
            company_name: document.getElementById('company').value.trim(),
          },
          address: {
            line1: document.getElementById('address').value.trim(),
            city: document.getElementById('city').value.trim(),
            state: document.getElementById('state').value.trim().toUpperCase(),
            zip: document.getElementById('zip').value.trim(),
            country: 'US',
          },
          plan: { tier: planKey, cadence: isAnnual ? 'annual' : 'monthly' },
          finix_payment_token: finixPaymentToken,
          hcaptcha_token: hcaptchaToken,
        };

        const res = await fetch(`${BACKEND_URL}/api/auth/signup`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const json = await res.json();
        if (json.error) throw new Error(json.error.message || 'Signup failed');

        if (json.data?.magic_link_url) {
          window.location.href = json.data.magic_link_url;
        } else {
          window.location.href = 'https://app.constructwise.ai/login?signup=1';
        }
      } catch (err) {
        showError(err instanceof Error ? err.message : 'Unexpected error');
        submitBtn?.removeAttribute('disabled');
      }
    });
  </script>
</BaseLayout>

<script>
  // An estimator's bid week, toggled between today and with ConstructWise.
  const rows = ['8a', '10a', '1p', '3p'];
  const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'];
  const weeks: Record<string, string[][]> = {
    before: [
      ['read', 'read', 'xl', 'xl', 'key'],
      ['read', 'xl', 'xl', 'key', 'key'],
      ['read', 'read', 'key', 'xl', 'bid'],
      ['xl', 'read', 'key', 'key', 'bid'],
    ],
    after: [
      ['judge', 'bid', 'bid', 'free', 'judge'],
      ['judge', 'bid', 'judge', 'bid', 'free'],
      ['bid', 'free', 'judge', 'bid', 'bid'],
      ['free', 'judge', 'bid', 'free', 'bid'],
    ],
  };
  const labels: Record<string, string> = {
    read: 'Reading drawings & specs',
    xl: 'Rebuilding Excel model',
    key: 'Keying activities',
    judge: 'Reviewing the draft',
    bid: 'Bid decisions',
    free: 'Next bid',
  };
  const weekGrid = document.getElementById('weekgrid');
  function renderWeek(w: string) {
    if (!weekGrid) return;
    let html = '<span></span>' + days.map((d) => `<span class="d">${d}</span>`).join('');
    rows.forEach((t, r) => {
      html += `<span class="t">${t}</span>`;
      weeks[w][r].forEach((k) => { html += `<span class="cell k-${k}">${labels[k]}</span>`; });
    });
    weekGrid.innerHTML = html;
  }
  renderWeek('before');
  document.querySelectorAll<HTMLButtonElement>('.seg2 button').forEach((b) => {
    b.addEventListener('click', () => {
      document.querySelectorAll('.seg2 button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      renderWeek(b.dataset.w || 'before');
    });
  });
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingNav from '../components/landing/LandingNav.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
---
<BaseLayout title="Pricing - ConstructWise">
  <div class="min-h-screen bg-gray-50 pt-16">
    <LandingNav />

    <!-- Hero -->
    <section class="text-center px-6 pt-16 pb-6 bg-gradient-to-b from-white to-gray-50">
      <div class="max-w-2xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-gray-900 leading-[1.15] mb-4">
          Intelligent Bid Estimation.<br />
          <span class="text-blue-600">Priced to build with you.</span>
        </h1>
        <p class="text-base text-gray-600 leading-relaxed mb-2 max-w-xl mx-auto">
          Every plan includes a monthly token allotment that powers your AI usage &mdash; bid generation, scheduling, document analysis, and chat. Use what you need, and only pay more if you go beyond.
        </p>
        <p class="text-xs text-gray-500">All plans billed per user &middot; Tokens included every month &middot; Pay-as-you-go above your allotment</p>
      </div>
    </section>

    <!-- Billing Toggle -->
    <div class="flex justify-center px-6 pt-7 pb-11">
      <div class="inline-flex bg-white border border-gray-200 rounded-xl p-[3px] gap-0.5 shadow-sm">
        <button id="monthlyBtn" class="px-5 py-2 rounded-lg text-gray-600 text-sm font-medium transition-colors">
          Monthly
        </button>
        <button id="annualBtn" class="relative px-5 py-2 rounded-lg bg-blue-600 text-white text-sm font-semibold transition-colors shadow-sm">
          Annual
          <span class="absolute -top-[9px] -right-3 bg-green-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-md">SAVE</span>
        </button>
      </div>
    </div>

    <!-- Pricing Cards -->
    <section class="max-w-[1120px] mx-auto px-6 pb-16">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">

        <!-- Foundation -->
        <div class="border border-gray-200 rounded-2xl p-9 pt-9 pb-7 bg-white shadow-sm flex flex-col hover:shadow-md hover:border-gray-300 transition-all">
          <div class="flex items-center gap-1.5 text-[11px] font-bold tracking-[0.8px] uppercase text-gray-500 mb-4">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
            STARTER
          </div>
          <p class="text-[13px] text-gray-500 mb-2 min-h-[40px]">For GCs and Large Trades</p>
          <h3 class="text-[28px] font-bold tracking-tight text-gray-900 mb-3">Foundation</h3>
          <p class="text-sm text-gray-600 leading-relaxed mb-7 h-[66px]">Everything you need to start shipping bids faster &mdash; with more confidence.</p>

          <div class="mb-6 pb-6 border-b border-gray-200">
            <div class="flex items-baseline gap-[3px] mb-[3px]">
              <span class="text-base font-semibold text-gray-600 self-start mt-1.5">$</span>
              <span class="text-[44px] font-extrabold tracking-[-2px] leading-none text-gray-900 pricing-amount" data-monthly="349" data-annual="300">300</span>
              <span class="text-sm text-gray-500 ml-0.5 font-normal">/user/mo</span>
            </div>
            <p class="text-xs text-gray-500 pricing-billing" data-monthly-text="billed monthly" data-annual-text="billed annually at $3,600/user — save">billed annually at $3,600/user &mdash; save</p>
            <div class="inline-block mt-2.5 px-3 py-1 bg-blue-50 text-blue-700 text-[13px] font-semibold rounded-md">1,000,000 tokens/mo included</div>
          </div>

          <div class="text-[10px] font-bold tracking-[1px] uppercase text-gray-500 mb-3.5">What's included</div>
          <ul class="space-y-2.5 text-[13.5px] text-gray-600 mb-6 flex-grow">
            <li class="flex items-start gap-2.5"><svg class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span><strong class="text-gray-900 font-semibold">AI bid generation</strong> from SOW + takeoff quantity uploads</span></li>
            <li class="flex items-start gap-2.5"><svg class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span><strong class="text-gray-900 font-semibold">Up to 3 users</strong> per company</span></li>
            <li class="flex items-start gap-2.5"><svg class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span><strong class="text-gray-900 font-semibold">AI Chat</strong> &mdash; ask questions about your bids and docs</span></li>
            <li class="flex items-start gap-2.5"><svg class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span><strong class="text-gray-900 font-semibold">AI Edit</strong> &mdash; modify bids via natural language</span></li>
            <li class="flex items-start gap-2.5"><svg class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span><strong class="text-gray-900 font-semibold">Company cost history</strong> &mdash; AI learns your pricing</span></li>
            <li class="flex items-start gap-2.5"><svg class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span><strong class="text-gray-900 font-semibold">5 GB</strong> document storage</span></li>
            <li class="flex items-start gap-2.5"><svg class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Excel &amp; PDF bid export</span></li>
            <li class="flex items-start gap-2.5"><svg class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Email &amp; chat support</span></li>
          </ul>

          <a href="/checkout?plan=foundation" class="block w-full text-center py-3 px-6 rounded-lg border border-gray-200 bg-white text-gray-900 text-sm font-semibold hover:bg-gray-50 hover:border-gray-300 transition-all">
            Select Plan &rarr;
          </a>
        </div>

        <!-- Podium (featured) -->
        <div class="border-2 border-blue-600 rounded-2xl p-9 pt-9 pb-7 bg-white shadow-lg shadow-blue-600/10 flex flex-col hover:shadow-xl hover:shadow-blue-600/15 transition-all">
          <div class="flex items-center gap-1.5 text-[11px] font-bold tracking-[0.8px] uppercase text-blue-600 mb-4">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M13 3l2.26 6.34L22 10.5l-5 4.37L18.18 22 13 18.27 7.82 22 9 14.87l-5-4.37 6.74-1.16z"/></svg>
            MOST POPULAR
          </div>
          <p class="text-[13px] text-gray-500 mb-2 min-h-[40px]">For growing estimating teams that run volume</p>
          <h3 class="text-[28px] font-bold tracking-tight text-blue-600 mb-3">Podium</h3>
          <p class="text-sm text-gray-600 leading-relaxed mb-7 h-[66px]">For estimating teams that run volume &mdash; with AI insights and risk modeling.</p>

          <div class="mb-6 pb-6 border-b border-gray-200">
            <div class="flex items-baseline gap-[3px] mb-[3px]">
              <span class="text-base font-semibold text-gray-600 self-start mt-1.5">$</span>
              <span class="text-[44px] font-extrabold tracking-[-2px] leading-none text-blue-600 pricing-amount" data-monthly="649" data-annual="600">600</span>
              <span class="text-sm text-gray-500 ml-0.5 font-normal">/user/mo</span>
            </div>
            <p class="text-xs text-gray-500 pricing-billing" data-monthly-text="billed monthly" data-annual-text="billed annually at $7,200/user — save">billed annually at $7,200/user &mdash; save</p>
            <div class="inline-block mt-2.5 px-3 py-1 bg-blue-50 text-blue-700 text-[13px] font-semibold rounded-md">3,000,000 tokens/mo included</div>
          </div>

          <div class="text-[10px] font-bold tracking-[1px] uppercase text-gray-500 mb-3.5">Everything in Foundation, plus</div>
          <ul class="space-y-2.5 text-[13.5px] text-gray-600 mb-6 flex-grow">
            <li class="flex items-start gap-2.5"><svg class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span><strong class="text-gray-900 font-semibold">Up to 15 users</strong> per company</span></li>
            <li class="flex items-start gap-2.5"><svg class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span><strong class="text-gray-900 font-semibold">Reusable Blocks</strong> for line items &amp; assemblies</span></li>
            <li class="flex items-start gap-2.5"><svg class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span><strong class="text-gray-900 font-semibold">Schedule generation</strong> from your cost estimate</span></li>
            <li class="flex items-start gap-2.5"><svg class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span><strong class="text-gray-900 font-semibold">Chance of anything</strong> risk modeling</span></li>
            <li class="flex items-start gap-2.5"><svg class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span><strong class="text-gray-900 font-semibold">Live market pricing</strong> &mdash; benchmark against your region</span></li>
            <li class="flex items-start gap-2.5"><svg class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span><strong class="text-gray-900 font-semibold">AI Insights audit</strong> &mdash; flags inconsistencies in bids</span></li>
            <li class="flex items-start gap-2.5"><svg class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span><strong class="text-gray-900 font-semibold">CPM schedules</strong> + AI-powered schedule risk modeling</span></li>
            <li class="flex items-start gap-2.5"><svg class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span><strong class="text-gray-900 font-semibold">25 GB</strong> document storage</span></li>
            <li class="flex items-start gap-2.5"><svg class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span><strong class="text-gray-900 font-semibold">Cost history</strong> &mdash; view &amp; compare line-item pricing trends</span></li>
            <li class="flex items-start gap-2.5"><svg class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Priority support + onboarding call</span></li>
          </ul>

          <a href="/checkout?plan=podium" class="block w-full text-center py-3 px-6 rounded-lg bg-blue-600 border border-blue-600 text-white text-sm font-semibold hover:bg-blue-700 hover:border-blue-700 transition-all shadow-sm">
            Select Plan &rarr;
          </a>
        </div>

        <!-- Summit -->
        <div class="border border-gray-200 rounded-2xl p-9 pt-9 pb-7 bg-white shadow-sm flex flex-col hover:shadow-md hover:border-gray-300 transition-all">
          <div class="flex items-center gap-1.5 text-[11px] font-bold tracking-[0.8px] uppercase text-gray-500 mb-4">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>
            ENTERPRISE
          </div>
          <p class="text-[13px] text-gray-500 mb-2 min-h-[40px]">$200M+ annual volume</p>
          <h3 class="text-[28px] font-bold tracking-tight text-gray-900 mb-3">Summit</h3>
          <p class="text-sm text-gray-600 leading-relaxed mb-7 h-[66px]">White-glove deployment for enterprise GCs and program managers with custom workflows.</p>

          <div class="mb-6 pb-6 border-b border-gray-200">
            <div class="text-[44px] font-bold tracking-[-1.5px] leading-none text-gray-900 mb-1">Let's talk.</div>
            <p class="text-xs text-gray-500">Custom pricing based on volume &amp; users</p>
            <div class="inline-block mt-2.5 px-3 py-1 bg-blue-50 text-blue-700 text-[13px] font-semibold rounded-md">7,000,000+ tokens/mo</div>
          </div>

          <div class="text-[10px] font-bold tracking-[1px] uppercase text-gray-500 mb-3.5">Everything in Podium, plus</div>
          <ul class="space-y-2.5 text-[13.5px] text-gray-600 mb-6 flex-grow">
            <li class="flex items-start gap-2.5"><svg class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span><strong class="text-gray-900 font-semibold">Unlimited users</strong></span></li>
            <li class="flex items-start gap-2.5"><svg class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span><strong class="text-gray-900 font-semibold">Master schedule</strong> &mdash; company-wide project view</span></li>
            <li class="flex items-start gap-2.5"><svg class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span><strong class="text-gray-900 font-semibold">Unlimited storage</strong></span></li>
            <li class="flex items-start gap-2.5"><svg class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span><strong class="text-gray-900 font-semibold">Dedicated success manager</strong></span></li>
            <li class="flex items-start gap-2.5"><svg class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Custom onboarding &amp; data migration</span></li>
          </ul>

          <a href="mailto:sales@constructwise.ai" class="block w-full text-center py-3 px-6 rounded-lg border border-gray-200 bg-white text-gray-900 text-sm font-semibold hover:bg-gray-50 hover:border-gray-300 transition-all">
            Contact sales &rarr;
          </a>
        </div>

      </div>
    </section>

    <!-- Token Top-up Packs -->
    <section class="max-w-[1120px] mx-auto px-6 pb-12">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-bold tracking-tight text-gray-900 mb-2">Need extra tokens?</h2>
        <p class="text-sm text-gray-600">Buy a top-up pack anytime &mdash; no subscription changes, no surprise invoices.</p>
      </div>

      <div class="overflow-x-auto bg-white border border-gray-200 rounded-2xl shadow-sm mb-4 max-w-2xl mx-auto">
        <table class="w-full border-collapse">
          <thead>
            <tr>
              <th class="px-5 py-4 text-center text-[13px] font-bold tracking-tight text-gray-900 bg-gray-50 border-b-2 border-gray-200">Tokens</th>
              <th class="px-5 py-4 text-center text-[13px] font-bold tracking-tight text-gray-900 bg-gray-50 border-b-2 border-gray-200">Price</th>
              <th class="px-5 py-4 text-center text-[13px] font-bold tracking-tight text-gray-900 bg-gray-50 border-b-2 border-gray-200">Per 1K tokens</th>
            </tr>
          </thead>
          <tbody class="text-[14px] text-gray-700">
            <tr class="border-b border-gray-200 bg-blue-50/30">
              <td class="px-5 py-4 text-center font-semibold text-gray-900">
                <span class="relative inline-block">
                  2,000,000
                  <span class="absolute left-full bottom-full ml-1 -mb-1 text-[10px] font-bold uppercase tracking-wider text-blue-700 bg-blue-100 px-2 py-0.5 rounded whitespace-nowrap">Best value</span>
                </span>
              </td>
              <td class="px-5 py-4 text-center font-bold text-blue-600 text-[18px]">$200</td>
              <td class="px-5 py-4 text-center text-gray-700 font-semibold">$0.10</td>
            </tr>
            <tr class="border-b border-gray-200">
              <td class="px-5 py-4 text-center font-semibold text-gray-900">800,000</td>
              <td class="px-5 py-4 text-center font-bold text-gray-900 text-[18px]">$100</td>
              <td class="px-5 py-4 text-center text-gray-700 font-semibold">$0.125</td>
            </tr>
            <tr class="border-b border-gray-200">
              <td class="px-5 py-4 text-center font-semibold text-gray-900">300,000</td>
              <td class="px-5 py-4 text-center font-bold text-gray-900 text-[18px]">$50</td>
              <td class="px-5 py-4 text-center text-gray-700 font-semibold">$0.167</td>
            </tr>
            <tr>
              <td class="px-5 py-4 text-center font-semibold text-gray-900">125,000</td>
              <td class="px-5 py-4 text-center font-bold text-gray-900 text-[18px]">$25</td>
              <td class="px-5 py-4 text-center text-gray-700 font-semibold">$0.20</td>
            </tr>
          </tbody>
        </table>
      </div>

    </section>

    <!-- Compare Plans Matrix -->
    <section class="max-w-[1120px] mx-auto px-6 pb-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-gray-900 mb-8">Compare plans</h2>
      <div class="overflow-x-auto bg-white border border-gray-200 rounded-2xl shadow-sm">
        <table class="w-full border-collapse">
          <thead>
            <tr>
              <th class="px-5 py-4 text-left text-[13px] font-bold tracking-tight text-gray-900 bg-gray-50 border-b-2 border-gray-200 w-[45%]">Feature</th>
              <th class="px-5 py-4 text-center text-[13px] font-bold tracking-tight text-gray-900 bg-gray-50 border-b-2 border-gray-200 w-[18.33%]">Foundation</th>
              <th class="px-5 py-4 text-center text-[13px] font-bold tracking-tight text-blue-600 bg-blue-50 border-b-2 border-gray-200 w-[18.33%]">Podium</th>
              <th class="px-5 py-4 text-center text-[13px] font-bold tracking-tight text-gray-900 bg-gray-50 border-b-2 border-gray-200 w-[18.33%]">Summit</th>
            </tr>
          </thead>
          <tbody class="text-[13.5px] text-gray-600">

            <tr><td colspan="4" class="px-5 py-2.5 text-[11px] font-bold tracking-[0.8px] uppercase text-gray-500 bg-gray-50">Pricing &amp; Usage</td></tr>
            <tr class="border-b border-gray-200"><td class="px-5 py-3">Monthly token allotment</td><td class="px-5 py-3 text-center text-gray-900 font-semibold text-[13px]">1M</td><td class="px-5 py-3 text-center text-gray-900 font-semibold text-[13px] bg-blue-50/40">3M</td><td class="px-5 py-3 text-center text-gray-900 font-semibold text-[13px]">7M+</td></tr>
            <tr class="border-b border-gray-200"><td class="px-5 py-3">Users per company</td><td class="px-5 py-3 text-center text-gray-900 font-semibold text-[13px]">Up to 3</td><td class="px-5 py-3 text-center text-gray-900 font-semibold text-[13px] bg-blue-50/40">Up to 15</td><td class="px-5 py-3 text-center text-gray-900 font-semibold text-[13px]">Unlimited</td></tr>
            <tr class="border-b border-gray-200"><td class="px-5 py-3">Free read-only collaborators</td><td class="px-5 py-3 text-center text-blue-600 font-bold">&#10003;</td><td class="px-5 py-3 text-center text-blue-600 font-bold bg-blue-50/40">&#10003;</td><td class="px-5 py-3 text-center text-blue-600 font-bold">&#10003;</td></tr>


  <script>
    // Billing toggle
    let billingPeriod = 'annual';
    const monthlyBtn = document.getElementById('monthlyBtn');
    const annualBtn = document.getElementById('annualBtn');
    const amounts = document.querySelectorAll('.pricing-amount');
    const billings = document.querySelectorAll('.pricing-billing');
    const planLinks = document.querySelectorAll('a[href^="/checkout"]');

    function updateLinks() {
      planLinks.forEach(link => {
        const url = new URL(link.href);
        url.searchParams.set('billing', billingPeriod);
        link.href = url.toString();
      });
    }

    function setAnnual() {
      billingPeriod = 'annual';
      annualBtn?.classList.add('bg-blue-600', 'text-white', 'font-semibold', 'shadow-sm');
      annualBtn?.classList.remove('text-gray-600', 'font-medium');
      monthlyBtn?.classList.remove('bg-blue-600', 'text-white', 'font-semibold', 'shadow-sm');
      monthlyBtn?.classList.add('text-gray-600', 'font-medium');
      amounts.forEach(el => { el.textContent = el.getAttribute('data-annual'); });
      billings.forEach(el => { el.textContent = el.getAttribute('data-annual-text'); });
      updateLinks();
    }

    function setMonthly() {
      billingPeriod = 'monthly';
      monthlyBtn?.classList.add('bg-blue-600', 'text-white', 'font-semibold', 'shadow-sm');
      monthlyBtn?.classList.remove('text-gray-600', 'font-medium');
      annualBtn?.classList.remove('bg-blue-600', 'text-white', 'font-semibold', 'shadow-sm');
      annualBtn?.classList.add('text-gray-600', 'font-medium');
      amounts.forEach(el => { el.textContent = el.getAttribute('data-monthly'); });
      billings.forEach(el => { el.textContent = el.getAttribute('data-monthly-text'); });
      updateLinks();
    }

    monthlyBtn?.addEventListener('click', setMonthly);
    annualBtn?.addEventListener('click', setAnnual);
    updateLinks();

    // FAQ accordion
    document.querySelectorAll('.faq-q').forEach(q => {
      q.addEventListener('click', () => {
        const item = q.closest('.faq-item');
        if (!item) return;
        const answer = item.querySelector('.faq-a');
        const icon = item.querySelector('.faq-icon');
        const isOpen = item.classList.contains('open');

        // Close any other open items
        document.querySelectorAll('.faq-item.open').forEach(other => {
          if (other !== item) {
            other.classList.remove('open');
            const otherAnswer = other.querySelector('.faq-a');
            const otherIcon = other.querySelector('.faq-icon');
            const otherQ = other.querySelector('.faq-q');
            if (otherAnswer) {
              otherAnswer.style.maxHeight = '0';
              otherAnswer.style.paddingTop = '0';
              otherAnswer.style.paddingBottom = '0';
            }
            if (otherIcon) otherIcon.textContent = '+';
            if (otherQ) otherQ.classList.remove('text-blue-600');
          }
        });

        if (isOpen) {
          item.classList.remove('open');
          if (answer) {
            answer.style.maxHeight = '0';
            answer.style.paddingTop = '0';
            answer.style.paddingBottom = '0';
          }
          if (icon) icon.textContent = '+';
          q.classList.remove('text-blue-600');
        } else {
          item.classList.add('open');
          if (answer) {
            // apply padding first so scrollHeight includes it
            answer.style.paddingTop = '16px';
            answer.style.paddingBottom = '8px';
            // animate from 0 to the measured content height + a buffer for safety
            answer.style.maxHeight = (answer.scrollHeight + 80) + 'px';
            // after the transition, drop the maxHeight constraint entirely so
            // long answers, font-load reflows, or window resizes never clip
            const onDone = (e) => {
              if (e.propertyName !== 'max-height') return;
              if (item.classList.contains('open')) {
                answer.style.maxHeight = 'none';
              }
              answer.removeEventListener('transitionend', onDone);
            };
            answer.addEventListener('transitionend', onDone);
          }
          if (icon) icon.textContent = '−';
          q.classList.add('text-blue-600');
        }
      });
    });
  </script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingNav from '../components/landing/LandingNav.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
import { features, tm } from '../data/solutions';
import UseCases from '../components/solutions/UseCases.astro';
---
<BaseLayout
  title="Solutions - ConstructWise"
  description="Built for commercial estimators and precon teams. Go from drawings and takeoffs to a detailed cost estimate in minutes, priced from your own history."
>
  <div class="min-h-screen bg-white pt-16">
    <LandingNav />

    <!-- Hero: who it's for, and the flow from your history to a first draft -->
    <section class="sol-hero">
      <div class="sol-wrap sol-hero-grid">
        <div class="min-w-0">
          <span class="sol-eyebrow">Solutions</span>
          <h1 class="sol-h1">Built for commercial estimators and <span>precon teams.</span></h1>
          <p class="sol-lede">Go from drawings and takeoffs to a detailed cost estimate in minutes, priced from your own history and built in your methods, your codes, and your format.</p>
          <div class="sol-cta">
            <a href="/demo?from=solutions-hero" class="sol-btn sol-btn-p">Request a Working Session &rarr;</a>
            <a href="/pricing" class="sol-btn sol-btn-g">See pricing</a>
          </div>
          <p class="sol-cred"><span aria-hidden="true">●</span> Built by estimators who have priced thousands of competitive bids.</p>
        </div>

        <!-- Flow artifact: your history + this project → a first draft that fits your process -->
        <div class="flow" aria-label="How a first draft is built">
          <div class="flow-in">
            <div class="fcard">
              <div class="fcard-h"><span class="fnum">1</span>Your history <span class="fcard-tag" set:html={tm('Data Hub')} /></div>
              <div class="chips">
                <span>Cost proposals</span><span>P&amp;Ls</span><span>CPM schedules</span><span>Unit rates</span>
              </div>
              <p class="fnote">Ingested once. Learns your methods and codes.</p>
            </div>
            <div class="fcard">
              <div class="fcard-h"><span class="fnum">2</span>This project</div>
              <ul class="files">
                <li><span class="fi">PDF</span>Architectural set<em>212 MB</em></li>
                <li><span class="fi">PDF</span>Specs, Div 01–33<em>48 MB</em></li>
                <li><span class="fi fi-x">XLS</span>Takeoff quantities<em>1 MB</em></li>
              </ul>
            </div>
          </div>

          <div class="flow-arrow" aria-hidden="true">
            <svg width="22" height="40" viewBox="0 0 22 40" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 2v34M3 28l8 8 8-8"/></svg>
          </div>

          <div class="fdraft">
            <div class="fdraft-top">
              <div>
                <div class="fdraft-lab"><span class="fnum fnum-d">3</span>Your first draft</div>
                <div class="fdraft-title">As if your seasoned estimators started it</div>
              </div>
              <div class="ring" style="--p: 70">
                <span>70%</span>
                <small>complete</small>
              </div>
            </div>
            <table class="dtable">
              <tbody>
                <tr><td class="mono">03 30 00</td><td>Cast-in-place concrete</td><td class="n">$1,204,860</td><td><span class="src">your rate</span></td></tr>
                <tr><td class="mono">09 21 16</td><td>Gypsum board assemblies</td><td class="n">$930,450</td><td><span class="src">A-201</span></td></tr>
                <tr><td class="mono">26 05 00</td><td>Electrical</td><td class="n">$1,560,000</td><td><span class="src">sub quote</span></td></tr>
              </tbody>
            </table>
            <div class="fdraft-foot">
              <span>Refine it in plain English with <b>AI Chat</b></span>
              <span class="fit">✓ Fits your process</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Key features (anchors for the Solutions mega menu) -->
    <section class="pillars">
      <div class="sol-wrap">
        <span class="sol-eyebrow">Key features</span>
        <h2 class="sol-h2">Less manual work on every bid.</h2>
        <p class="sol-sub">So your estimators spend their hours on the calls that decide the job.</p>
        <div class="pgrid">
          {features.map((f) => (
            <div class="pcard" id={f.id}>
              <span class="pico" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={f.icon} /></span>
              <h3><span set:html={tm(f.name)} />{f.badge && <span class="pbadge">{f.badge}</span>}</h3>
              <p class="pdesc">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <UseCases />

    <!-- Testimonial Section -->
    <section class="py-20 bg-gray-50">
      <div class="container mx-auto px-4 max-w-4xl">
        <div class="md:grid-cols-2 gap-8">
          <div class="bg-white p-6 rounded-xl shadow-md grid grid-cols-1 md:grid-cols-2">
            <div class="mx-4 m-15">
              <h3 class="text-xl mb-10">&quot;ConstructWise offloads so much of the painstaking manual processes anyone could do. It allows us to spend more time to think critically about bidding decisions and quantify how they'll impact the holistic project.&quot;</h3>
              <p class="font-bold">Jeremy Hynum</p>
              <p class="text-gray-600">Estimator, Rise Construction</p>
            </div>
            <div class="bg-gray-100 rounded-lg flex items-center justify-center p-8">
              <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full max-w-[200px]">
                <!-- Abstract construction/building graphic -->
                <rect x="30" y="60" width="50" height="110" rx="4" fill="#2563eb" opacity="0.15"/>
                <rect x="40" y="40" width="50" height="130" rx="4" fill="#2563eb" opacity="0.3"/>
                <rect x="75" y="20" width="50" height="150" rx="4" fill="#2563eb" opacity="0.5"/>
                <rect x="110" y="50" width="50" height="120" rx="4" fill="#2563eb" opacity="0.35"/>
                <rect x="120" y="70" width="50" height="100" rx="4" fill="#2563eb" opacity="0.2"/>
                <!-- Upward trend line -->
                <path d="M30 160 L70 120 L110 90 L150 40" stroke="#2563eb" stroke-width="3" stroke-linecap="round"/>
                <circle cx="150" cy="40" r="5" fill="#2563eb"/>
              </svg>
            </div>
          </div>
        </div>

        <!-- Working session CTA -->
        <div class="mt-12 flex flex-col items-center text-center gap-4">
          <p class="text-lg text-gray-700">See what it does on a bid you know cold.</p>
          <a href="/demo?from=solutions-testimonial" class="inline-flex items-center justify-center h-12 px-7 rounded-lg bg-blue-600 text-white text-base font-semibold shadow-sm hover:bg-blue-700 transition-colors">
            Request a Working Session &rarr;
          </a>
          <p class="text-sm text-gray-500">30 minutes, on a real construction plan set.</p>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 px-4 bg-blue-600">
      <div class="container mx-auto text-center">
        <h2 class="text-4xl font-bold text-white mb-6">Elevate Your Construction Planning Today</h2>
        <p class="text-xl text-blue-100 mb-8 max-w-2xl mx-auto">
          Join the commercial estimators and precon teams bidding more work with a number they can defend.
        </p>
      </div>
    </section>

    <LandingFooter />
  </div>
</BaseLayout>

<style>
  .sol-wrap { max-width: 1200px; margin: 0 auto; padding-left: 24px; padding-right: 24px; }
  .mono { font-family: 'Geist Mono', ui-monospace, monospace; }
  .sol-eyebrow { font: 500 12px 'Geist Mono', ui-monospace, monospace; letter-spacing: .14em; text-transform: uppercase; color: #2563eb; }

  /* ---------- Hero ---------- */
  .sol-hero {
    background:
      radial-gradient(60% 70% at 85% 20%, rgba(37,99,235,.12), transparent 60%),
      linear-gradient(rgba(37,99,235,.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(37,99,235,.05) 1px, transparent 1px),
      linear-gradient(180deg, #f5f8ff, #fff);
    background-size: 100% 100%, 28px 28px, 28px 28px, 100% 100%;
    border-bottom: 1px solid #eef0f3;
  }
  .sol-hero-grid { padding-top: 72px; padding-bottom: 80px; display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); gap: 56px; align-items: center; }
  .sol-h1 { margin-top: 14px; font-size: clamp(36px, 4.2vw, 50px); line-height: 1.02; letter-spacing: -0.03em; font-weight: 700; color: #0f172a; text-wrap: balance; }
  .sol-h1 span { color: #2563eb; }
  .sol-lede { margin-top: 20px; font-size: 18px; line-height: 1.6; color: #475569; max-width: 44ch; }
  .sol-cred { margin-top: 22px; font-size: 14px; color: #64748b; display: flex; align-items: center; gap: 8px; }
  .sol-cred span { color: #2563eb; font-size: 9px; }
  .sol-cta { margin-top: 30px; display: flex; flex-wrap: wrap; gap: 12px; }
  .sol-btn { display: inline-flex; align-items: center; justify-content: center; height: 48px; padding: 0 22px; border-radius: 8px; font-weight: 600; font-size: 15px; white-space: nowrap; transition: background .15s, border-color .15s; }
  .sol-btn-p { background: #2563eb; color: #fff; box-shadow: 0 8px 20px -10px rgba(37,99,235,.7); }
  .sol-btn-p:hover { background: #1d4ed8; }
  .sol-btn-g { border: 1px solid #d1d5db; color: #111827; background: #fff; }
  .sol-btn-g:hover { border-color: #9ca3af; }

  /* Flow artifact */
  .flow { display: grid; gap: 10px; min-width: 0; }
  .flow-in { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .fcard { background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; padding: 16px; box-shadow: 0 12px 30px -20px rgba(15,23,42,.3); display: grid; gap: 10px; align-content: start; min-width: 0; }
  .fcard-h { display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: 14px; color: #0f172a; flex-wrap: wrap; }
  .fcard-tag { margin-left: auto; font: 600 11px 'Geist Mono', ui-monospace, monospace; color: #1e40af; background: #dbeafe; border-radius: 5px; padding: 2px 7px; }
  .fnum { width: 20px; height: 20px; border-radius: 50%; background: #eff6ff; color: #2563eb; display: inline-grid; place-items: center; font: 600 11px 'Geist Mono', ui-monospace, monospace; flex: none; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chips span { font-size: 12.5px; font-weight: 500; color: #334155; background: #f1f5f9; border-radius: 6px; padding: 4px 8px; }
  .fnote { font-size: 12.5px; color: #64748b; }
  .files { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .files li { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #1f2937; min-width: 0; }
  .files em { margin-left: auto; font: 500 11px 'Geist Mono', ui-monospace, monospace; color: #94a3b8; font-style: normal; white-space: nowrap; }
  .fi { font: 700 9px 'Geist Mono', ui-monospace, monospace; color: #b91c1c; background: #fee2e2; border-radius: 4px; padding: 3px 4px; flex: none; }
  .fi-x { color: #166534; background: #dcfce7; }
  .flow-arrow { display: grid; place-items: center; }

  .fdraft { background: #0d1526; color: #e2e8f0; border-radius: 16px; padding: 20px; box-shadow: 0 30px 60px -24px rgba(13,21,38,.6); display: grid; gap: 14px; min-width: 0;
    background-image: linear-gradient(rgba(148,163,184,.06) 1px, transparent 1px), linear-gradient(90deg, rgba(148,163,184,.06) 1px, transparent 1px); background-size: 24px 24px; }
  .fdraft-top { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .fdraft-lab { display: flex; align-items: center; gap: 8px; font: 600 11.5px 'Geist Mono', ui-monospace, monospace; letter-spacing: .1em; text-transform: uppercase; color: #93c5fd; }
  .fnum-d { background: #2563eb; color: #fff; }
  .fdraft-title { margin-top: 6px; font-size: 18px; font-weight: 600; color: #fff; line-height: 1.3; }
  .ring { --p: 70; flex: none; width: 78px; height: 78px; border-radius: 50%; display: grid; place-content: center; text-align: center;
    background: radial-gradient(closest-side, #0d1526 78%, transparent 80% 100%), conic-gradient(#3b82f6 calc(var(--p) * 1%), rgba(148,163,184,.25) 0); }
  .ring span { font-size: 19px; font-weight: 700; color: #fff; line-height: 1; }
  .ring small { font: 500 9px 'Geist Mono', ui-monospace, monospace; color: #94a3b8; text-transform: uppercase; letter-spacing: .08em; margin-top: 3px; }
  .dtable { width: 100%; border-collapse: collapse; font-size: 13px; background: #fff; color: #1f2937; border-radius: 10px; overflow: hidden; }
  .dtable td { padding: 9px 12px; border-top: 1px solid #f1f3f6; }
  .dtable tr:first-child td { border-top: 0; }
  .dtable td.mono { font-size: 12px; color: #475569; white-space: nowrap; }
  .dtable td.n { text-align: right; font: 500 12.5px 'Geist Mono', ui-monospace, monospace; white-space: nowrap; }
  .src { font: 500 10.5px 'Geist Mono', ui-monospace, monospace; color: #2563eb; background: #eff6ff; border-radius: 4px; padding: 1px 6px; white-space: nowrap; }
  .fdraft-foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; font-size: 13px; color: #b9c4d6; }
  .fdraft-foot b { color: #fff; font-weight: 600; }
  .fit { font: 600 11.5px 'Geist Mono', ui-monospace, monospace; color: #86efac; }

  /* ---------- Pillars ---------- */
  .pillars { padding: 88px 0 96px; background: #fff; }
  .sol-h2 { margin-top: 10px; font-size: clamp(28px, 3.4vw, 40px); line-height: 1.08; letter-spacing: -0.025em; font-weight: 700; color: #0f172a; text-wrap: balance; max-width: 24ch; }
  .pgrid { margin-top: 36px; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; }
  .sol-sub { margin-top: 12px; font-size: 17px; color: #475569; }
  .pcard { border: 1px solid #e7e9ee; border-radius: 16px; padding: 22px; display: grid; gap: 10px; align-content: start; background: #fbfcfe; scroll-margin-top: 96px; min-width: 0; transition: border-color .15s, box-shadow .15s; }
  .pcard:hover { border-color: #bfdbfe; box-shadow: 0 12px 30px -20px rgba(37,99,235,.4); }
  .pcard:target { border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,.18); }
  .pico { width: 40px; height: 40px; border-radius: 10px; background: #eff6ff; color: #2563eb; display: grid; place-items: center; }
  .pcard h3 { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 18px; font-weight: 700; letter-spacing: -0.01em; color: #0f172a; line-height: 1.3; }
  .pbadge { font: 600 9.5px 'Geist Mono', ui-monospace, monospace; letter-spacing: 0; color: #1e40af; background: #dbeafe; border-radius: 4px; padding: 2px 5px; }
  .pdesc { font-size: 14.5px; color: #475569; line-height: 1.55; }

  @media (max-width: 1024px) {
    .sol-hero-grid { grid-template-columns: minmax(0, 1fr); gap: 44px; padding-top: 56px; padding-bottom: 64px; }
    .pgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .sol-wrap { padding-left: 16px; padding-right: 16px; }
    .flow-in { grid-template-columns: minmax(0, 1fr); }
    .pgrid { grid-template-columns: minmax(0, 1fr); }
    .dtable td:nth-child(2) { display: none; }
    .sol-cta .sol-btn { flex: 1 1 100%; }
    .pillars { padding: 64px 0 72px; }
  }
</style>

---
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'ConstructWise', description = 'AI-powered construction planning and cost estimation platform.' } = Astro.props;

const path = Astro.url.pathname;
const canonicalPath = path === '/' || path.endsWith('/') ? path : `${path}/`;
const canonicalURL = new URL(canonicalPath, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18133141995" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'AW-18133141995');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="antialiased font-sans">
    <slot />
  </body>
</html>

---
// Black Friday 2026 teaser (sale runs Nov 27 to Dec 4). Shows from deploy until 11:59 p.m. Pacific on Dec 4, then
// removes itself in the visitor's browser (the site is static, so no redeploy is needed).
---
<div id="promo-banner" class="promo" role="region" aria-label="Black Friday promotion">
  <p>
    <span class="promo-tag">Black Friday sale</span>
    <strong>20% off any plan for up to 1 year</strong>
    <span class="promo-dates">Starts Friday, Nov 27 &middot; Ends Dec 4 &middot; Demo sign-ups only</span>
  </p>
  <a href="/demo?from=black-friday">Book a demo &rarr;</a>
</div>
<script is:inline>
  (function () {
    var end = Date.parse('2026-12-04T23:59:00-08:00');
    var left = end - Date.now();
    if (left <= 0) return;
    var root = document.documentElement;
    root.classList.add('has-promo');
    setTimeout(function () { root.classList.remove('has-promo'); }, left);
  })();
</script>

<style is:global>
  html { --promo-h: 0px; }
  html.has-promo { --promo-h: 48px; }
  .promo { display: none; }
  html.has-promo .promo {
    display: flex; align-items: center; justify-content: center; gap: 20px;
    height: var(--promo-h); padding: 0 16px;
    background: #fbbf24; color: #111827; font-size: 15px; line-height: 1.3;
  }
  .promo p { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; column-gap: 12px; }
  .promo-tag { font-size: 12px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
  .promo strong { font-weight: 800; }
  .promo a {
    flex-shrink: 0; border-radius: 8px; background: #111827; color: #fff;
    padding: 6px 14px; font-size: 14px; font-weight: 600;
  }
  .promo a:hover { background: #1e40af; }
  .promo-offset { padding-top: calc(5rem + var(--promo-h)); }
  @media (max-width: 640px) {
    html.has-promo { --promo-h: 100px; }
    html.has-promo .promo { justify-content: space-between; gap: 12px; font-size: 14px; }
    .promo p { justify-content: flex-start; column-gap: 8px; }
    .promo-tag { width: 100%; font-size: 11px; }
    .promo-dates { font-size: 12px; }
  }
</style>
